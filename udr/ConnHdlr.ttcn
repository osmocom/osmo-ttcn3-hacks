/**************************************
 * N11 Namf (SBI): Emulated AMF
 **************************************/

const charstring Namf_uri_prefix := c_SCP_uri_prefix;

const charstring Namf_Callback_path_api_prefix := "/namf-callback/v1";

template (value) charstring ts_Namf_uri_callback_dereg_notify(template (value) charstring imsi)
:= Namf_uri_prefix & Namf_Callback_path_api_prefix & "/imsi-" & valueof(imsi) & "/dereg-notify";


}
