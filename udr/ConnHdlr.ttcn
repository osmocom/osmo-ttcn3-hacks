module ConnHdlr {

import from TCCEncoding_Functions all;

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from HTTP2_Types all;
import from HTTP2_Templates all;
import from HTTP2_Functions all;
import from HTTP2_Msg all;
import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from Prometheus_Checker all;

import from TS29505_Subscription_Data all;
import from TS29505_Subscription_Data_Templates all;

import from UDR_Tests all;

const integer HTTP2_CONN_SCP := 0;

/* These are a preset of path matches which can be applied through the entire lifecycle of the session: */
function f_http2_server_path_match()
runs on ConnHdlr return charstring {
	var charstring imsi_match := "*imsi-" & g_pars.imsi_str & "*";
	return imsi_match;
}

type record ConnHdlrPars {
	hexstring imsi,
	charstring imsi_str,
	charstring serving_network,

	charstring permanent_key,
	charstring opc,
	AuthenticationSubscription auth_subscr optional
}

type component ConnHdlr extends HTTP2_CT, HTTP2_ConnHdlr, Prometheus_Checker_CT {
	var ConnHdlrPars g_pars;
}

type function void_fn() runs on ConnHdlr;

function f_ConnHdlrPars(integer idx := 0) return ConnHdlrPars
{
	var hexstring imsi := f_concat_pad(lengthof(mp_imsi), substr(mp_imsi, 0, lengthof(mp_imsi) - 6), idx);
	var charstring imsi_str := f_dec_TBCD(imsi_hex2oct(imsi));
	var template (value) ConnHdlrPars pars := {
		imsi := imsi,
		imsi_str := imsi_str,
		serving_network := "5G:mnc070.mcc999.3gppnetwork.org", /* TODO: set based on mp_mcc and mp_mnc */
		permanent_key := "3c6e0b8a9c15224a8228b9a98ca1531d",
		opc := "762a2206fe0b4151ace403c86a11e479",
		auth_subscr := omit
	};
	return valueof(pars);
}

function f_ConnHdlr_init(void_fn fn, ConnHdlrPars pars) runs on ConnHdlr {
	/* make parameters available via component variable */
	g_pars := pars;

	/* Setup */
	/* Register SCP HTTP2 sever, where IUT will send all SBI requests: */
	f_http2_server_emu_register(f_http2_server_path_match(), idx := HTTP2_CONN_SCP);
	f_http2_adapter_init();

	fn.apply();

	/* Cleanup */
	f_http2_server_emu_unregister(f_http2_server_path_match(), idx := HTTP2_CONN_SCP);
}

/********************************************
 * SCP
/*******************************************/
const charstring c_SCP_uri_hostport := mp_scp_local_ip & ":" & int2str(mp_scp_local_port);
const charstring c_SCP_uri_prefix := "http://" & c_SCP_uri_hostport;

/************************************************************************************
 * N35 Nudr_DataRepository (SBI): Emulated UDM, 3GPP TS 29.504, 3GPP TS 29.505 A.2
 ************************************************************************************/

const charstring c_Nudr_uri_hostport := mp_udr_hostname & ":" & int2str(mp_udr_sbi_port);
const charstring c_Nudr_uri_prefix := "http://" & c_Nudr_uri_hostport;

/* 3GPP TS 29.505 5.4.2.23 */
function f_Nudr_DR_sqn_int2hex(integer sqn) return HEX12n
{
	return int2hex(sqn, 12);
}
private function f_Nudr_DR_sqn_hex2int(HEX12n sqn) return integer
{
	return hex2int(sqn);
}

function f_ts_PlmnIdNid()
runs on ConnHdlr return TS29505_Subscription_Data.PlmnIdNid {
	return valueof(TS29505_Subscription_Data_Templates.ts_PlmnIdNid("001", "001"));
}

function f_ts_Guami()
runs on ConnHdlr return TS29505_Subscription_Data.Guami {
	var template (value) TS29505_Subscription_Data.PlmnIdNid plmn_id_nid := f_ts_PlmnIdNid();
	return valueof(TS29505_Subscription_Data_Templates.ts_Guami(plmnId := plmn_id_nid,
								    amfId := "020040"));
}

/* 3GPP TS 29.505 5.2.2.3.1 Resource: AuthenticationSubscription (GET) */
private function f_n35_prepare_get_authentication_subscription()
runs on ConnHdlr return HTTP2_Msg {
	var integer http2_idx := f_http2_adapter_find_free_idx();
	var integer http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	var template (value) HTTP2_Msg http2_tx;

	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "GET",
										      scheme := "http",
										      authority := c_Nudr_uri_hostport,
										      path := ts_Nudr_DR_path_authentication_subscription(g_pars.imsi_str)),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-udm"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 });
	return valueof(http2_tx);
}

/* 3GPP TS 29.505 5.2.2.3.1 Resource: AuthenticationSubscription (GET) */
function f_n35_get_authentication_subscription(template integer exp_sqn := ?)
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	http2_tx := f_n35_prepare_get_authentication_subscription();
	f_http2_adapter_connect(mp_udr_hostname, mp_udr_sbi_port, mp_udm_local_ip, idx := http2_tx.conn_id);
	f_http2_adapter_send(http2_tx);

	/* 3GPP TS 29.505 Table 5.2.2.3.1-3 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := decmatch tr_AuthenticationSubscription(authenticationMethod := ts_AuthMethod(FiveG_AKA),
												encPermanentKey := g_pars.permanent_key,
												sequenceNumber := tr_SequenceNumber(sqn := ?),
												encOpcKey := g_pars.opc)));
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_dec_AuthenticationSubscription(http2_rx.body.data, g_pars.auth_subscr); // TODO: validate return code
	var integer rx_sqn := f_Nudr_DR_sqn_hex2int(str2hex(g_pars.auth_subscr.sequenceNumber.sqn));
	if (not match(rx_sqn, exp_sqn)) {
		Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail,
			log2str("Rx unexpected sqn ", rx_sqn, " vs exp ", exp_sqn));
	}

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

/* 3GPP TS 29.505 5.2.2.3.1 Resource: AuthenticationSubscription (PATCH) */
private function f_n35_prepare_patch_authentication_subscription(template (value) PatchItem_list patch_item_li)
runs on ConnHdlr return HTTP2_Msg {
	var integer http2_idx := f_http2_adapter_find_free_idx();
	var integer http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	var template (value) HTTP2_Msg http2_tx;
	var octetstring patch_item_li_enc;

	patch_item_li_enc := f_enc_PatchItem_list(valueof(patch_item_li));

	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "PATCH",
										      scheme := "http",
										      authority := c_Nudr_uri_hostport,
										      path := ts_Nudr_DR_path_authentication_subscription(g_pars.imsi_str)),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json-patch+json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-udm"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := patch_item_li_enc));
	return valueof(http2_tx);
}

/* 3GPP TS 29.505 5.2.2.3.2 Resource: AuthenticationSubscription (PATCH) */
function f_n35_patch_authentication_subscription(template (value) PatchItem_list patch_item_li)
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	http2_tx := f_n35_prepare_patch_authentication_subscription(patch_item_li);
	f_http2_adapter_connect(mp_udr_hostname, mp_udr_sbi_port, mp_udm_local_ip, idx := http2_tx.conn_id);
	f_http2_adapter_send(http2_tx);

	/* 3GPP TS 29.505 Table 5.2.2.3.2-3 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(204)),
			     omit);
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}


/* 3GPP TS 29.505 5.2.6.3.1 Resource: Amf3GppAccessRegistration (PUT) */
private function f_n35_prepare_put_amf_3gpp_access(template (value) Amf3GppAccessRegistration acc_reg)
runs on ConnHdlr return HTTP2_Msg {
	var integer http2_idx := f_http2_adapter_find_free_idx();
	var integer http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	var template (value) HTTP2_Msg http2_tx;
	var octetstring acc_reg_enc;

	acc_reg_enc := f_enc_Amf3GppAccessRegistration(valueof(acc_reg));

	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "PUT",
										      scheme := "http",
										      authority := c_Nudr_uri_hostport,
										      path := ts_Nudr_DR_path_amf_3gpp_access(g_pars.imsi_str)),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json,application/problem+json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-udm"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := acc_reg_enc));
	return valueof(http2_tx);
}

/* 3GPP TS 29.505 5.2.6.3.1 Resource: Amf3GppAccessRegistration (PUT) */
function f_n35_put_amf_3gpp_access()
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;
	var template (value) Amf3GppAccessRegistration acc_reg;

	acc_reg := ts_Amf3GppAccessRegistration(amfInstanceId := "d8073276-cd2a-41f1-aa56-07dfb4f73c6e",
						deregCallbackUri := ts_Namf_uri_callback_dereg_notify(g_pars.imsi_str),
						initialRegistrationInd := true,
						guami := f_ts_Guami(),
						ratType := ts_RatType(NR));

	http2_tx := f_n35_prepare_put_amf_3gpp_access(acc_reg);
	f_http2_adapter_connect(mp_udr_hostname, mp_udr_sbi_port, mp_udm_local_ip, idx := http2_tx.conn_id);
	f_http2_adapter_send(http2_tx);

	/* 3GPP TS 29.505 Table 5.2.6.3.1-3 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(204)),
			     omit);
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

