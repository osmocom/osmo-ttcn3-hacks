const charstring c_Nudm_UEAU_path_api_prefix := "/nudm-ueau/v1";

/* 6.3.3.2 Resource: SecurityInformation */
template (value) charstring
ts_Nudm_UEAU_path_security_information(template (value) charstring imsi)
:= c_Nudm_UEAU_path_api_prefix & "/" & valueof(ts_sbi_Supi(imsi)) & "/security-information";

/* 6.3.3.2.4.2 Operation: generate-auth-data */
template (present) charstring
tr_Nudm_UEAU_path_generate_auth_data(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudm_UEAU_path_api_prefix & "/imsi-" & imsi & "/security-information/generate-auth-data";
template (value) charstring
ts_Nudm_UEAU_path_generate_auth_data(template (value) charstring imsi)
:= valueof(ts_Nudm_UEAU_path_security_information(imsi)) & "/generate-auth-data";

/* 6.3.3.3 Resource: AuthEvents */
template (present) charstring
tr_Nudm_UEAU_path_auth_events(template (value) charstring imsi)
:= pattern c_Nudm_UEAU_path_api_prefix & "/imsi-" & imsi & "/auth-events";
template (value) charstring
ts_Nudm_UEAU_path_auth_events(template (value) charstring imsi)
:= c_Nudm_UEAU_path_api_prefix & "/" & valueof(ts_sbi_Supi(imsi)) & "/auth-events";

/* 6.3.3.6 Resource: Individual AuthEvent */
template (value) charstring
ts_Nudm_UEAU_path_indivdual_auth_event(template (value) charstring imsi,
				       template (value) charstring auth_event_id)
:= valueof(ts_Nudm_UEAU_path_auth_events(imsi)) & "/" & valueof(auth_event_id);

