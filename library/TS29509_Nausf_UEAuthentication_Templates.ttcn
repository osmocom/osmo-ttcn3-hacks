module TS29509_Nausf_UEAuthentication_Templates {

import from TS29509_Nausf_UEAuthentication all;

const charstring c_Nausf_UEAuthentication_path_api_prefix := "/nausf-auth/v1";

/* 3GPP TS 29.503 6.1.3.2 Resource: ue-authentications (Collection) */
const charstring c_Nausf_UEAuthentication_path_ue_authentications
:= c_Nausf_UEAuthentication_path_api_prefix & "/ue-authentications" ;

template (value) charstring
ts_Nausf_UEAuthentication_path_individual_ue_authentication(template (value) charstring auth_ctx_id)
:= c_Nausf_UEAuthentication_path_ue_authentications & "/" & valueof(auth_ctx_id);

/* 3GPP TS 29.509 6.1.3.3 Resource: 5g-aka-confirmation */
template (value) charstring
ts_Nausf_UEAuthentication_path_5g_aka_confirmation(template (value) charstring auth_ctx_id)
:= valueof(ts_Nausf_UEAuthentication_path_individual_ue_authentication(auth_ctx_id)) & "/5g-aka-confirmation";

template (value) AuthType
ts_AuthType(AuthType_enum enum_val) := {
	enum_val := enum_val
}

template (value) ResStar
ts_ResStar(template (value) charstring val) := {
	val := val
}

type TS29509_Nausf_UEAuthentication.AuthenticationInfo.cellCagInfo CagIdList;
template (value) AuthenticationInfo
ts_AuthenticationInfo(template (value) SupiOrSuci supiOrSuci,
		      template (value) ServingNetworkName servingNetworkName,
		      template (omit) ResynchronizationInfo resynchronizationInfo := omit,
		      template (omit) Pei pei := omit,
		      template (omit) TraceData traceData := omit,
		      template (omit) NfGroupId udmGroupId := omit,
		      template (omit) charstring routingIndicator := omit,
		      template (omit) CagIdList cellCagInfo := omit,
		      template (omit) boolean n5gcInd := omit,
		      template (omit) SupportedFeatures supportedFeatures := omit,
		      template (omit) boolean nswoInd := omit,
		      template (omit) boolean disasterRoamingInd := omit,
		      template (omit) boolean onboardingInd := omit,
		      template (omit) boolean aun3Ind := omit) := {
	supiOrSuci := supiOrSuci,
	servingNetworkName := servingNetworkName,
	resynchronizationInfo := resynchronizationInfo,
	pei := pei,
	traceData := traceData,
	udmGroupId := udmGroupId,
	routingIndicator := routingIndicator,
	cellCagInfo := cellCagInfo,
	n5gcInd := n5gcInd,
	supportedFeatures := supportedFeatures,
	nswoInd := nswoInd,
	disasterRoamingInd := disasterRoamingInd,
	onboardingInd := onboardingInd,
	aun3Ind  := aun3Ind
}

type TS29509_Nausf_UEAuthentication.UEAuthenticationCtx.fivegAuthData FivegAuthDataUnion;
type TS29509_Nausf_UEAuthentication.UEAuthenticationCtx.links LinksMap;
template (present) UEAuthenticationCtx
tr_UEAuthenticationCtx(template (present) AuthType authType := ?,
		       template (present) FivegAuthDataUnion fivegAuthData := ?,
		       template (present) LinksMap links := ?,
		       template ServingNetworkName servingNetworkName := *) := {
	authType := authType,
	fivegAuthData := fivegAuthData,
	links := links,
	servingNetworkName := servingNetworkName
}

template (value) ConfirmationData
ts_ConfirmationData(template (value) ResStar resStar,
		    template (omit) SupportedFeatures supportedFeatures := omit) := {
	resStar := resStar,
	supportedFeatures := supportedFeatures
}

type TS29509_Nausf_UEAuthentication.ConfirmationDataResponse.pvsInfo ServerAddressingInfoList;
template (present) ConfirmationDataResponse
tr_ConfirmationDataResponse(template (present) AuthResult authResult := ?,
			    template Supi supi  := *,
			    template Kseaf kseaf  := *,
			    template ServerAddressingInfoList pvsInfo  := *) := {
	authResult := authResult,
	supi := supi,
	kseaf := kseaf,
	pvsInfo := pvsInfo
}

}
