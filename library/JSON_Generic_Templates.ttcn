module JSON_Generic_Templates {

import from JSON_Generic_Null_Def all;
import from JSON_Generic all;

import from Misc_Helpers all;

template (present) JSON_generic_val
tr_JSON_generic_val_object(template (present) JSON_Generic.JSON_generic_val.JSON_object json_obj := ?) := {
	JSON_object := json_obj
}

template (present) JSON_generic_val
tr_JSON_generic_val_integer(template (present) integer val := ?) := {
	JSON_integer := val
}

function f_JSON_Generic_val_object_get_val(JSON_generic_val json, universal charstring key)
return JSON_generic_val {
	if (not ischosen(json.JSON_object)) {
		 Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, log2str("json is not an object: ", json));
	}
	for (var integer i := 0; i < lengthof(json.JSON_object); i := i + 1) {
		if (json.JSON_object[i].key == key) {
			return json.JSON_object[i].val;
		}
	}
	Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, log2str("json has no key ", key, ": ", json));
	return json;
}

}
