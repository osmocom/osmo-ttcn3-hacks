import from TS29502_Nsmf_PDUSession all;

template (value) SmContextCreateData
ts_SmContextCreateData(template (omit) TS29571_CommonData.Supi supi := omit,
		       template (omit) boolean unauthenticatedSupi := omit,
		       template (omit) TS29571_CommonData.Pei pei := omit,
		       template (omit) TS29571_CommonData.Gpsi gpsi := omit,
		       template (omit) TS29571_CommonData.PduSessionId pduSessionId := omit,
		       template (omit) TS29571_CommonData.Dnn dnn := omit,
		       template (omit) TS29571_CommonData.Snssai sNssai := omit,
		       template (omit) TS29571_CommonData.Snssai hplmnSnssai := omit,
		       template (value) TS29571_CommonData.NfInstanceId servingNfId,
		       template (omit) TS29571_CommonData.Guami guami := omit,
		       //template (omit) TS29510_Nnrf_NFManagement.ServiceName serviceName := omit,
		       template (value) TS29571_CommonData.PlmnId servingNetwork,
		       template (omit) RequestType requestType := omit,
		       template (omit) TS29571_CommonData.RefToBinaryData n1SmMsg := omit,
		       template (value) TS29571_CommonData.AccessType anType,
		       template (omit) TS29571_CommonData.RatType ratType := omit,
		       template (omit) TS29571_CommonData.PresenceState presenceInLadn := omit,
		       template (omit) TS29571_CommonData.UserLocation ueLocation := omit,
		       template (omit) TS29571_CommonData.TimeZone ueTimeZone := omit,
		       template (omit) TS29571_CommonData.UserLocation addUeLocation := omit,
		       template (value) TS29571_CommonData.Uri smContextStatusUri,
		       template (omit) TS29571_CommonData.Uri hSmfUri := omit,
		       template (omit) record of TS29571_CommonData.Uri additionalHsmfUri := omit,
		       template (omit) TS29571_CommonData.PduSessionId oldPduSessionId := omit,
		       template (omit) record of TS29571_CommonData.PduSessionId pduSessionsActivateList := omit,
		       template (omit) EpsPdnCnxContainer ueEpsPdnConnection := omit,
		       template (omit) HoState hoState := omit,
		       template (omit) TS29571_CommonData.NfInstanceId pcfId := omit,
		       template (omit) TS29571_CommonData.Uri nrfUri := omit,
		       template (omit) TS29571_CommonData.SupportedFeatures supportedFeatures := omit,
		       template (omit) DnnSelectionMode selMode := omit,
		       template (omit) record of TS29571_CommonData.BackupAmfInfo backupAmfInfo := omit,
		       template (omit) TS29571_CommonData.TraceData traceData := omit,
		       template (omit) TS29571_CommonData.NfGroupId udmGroupId := omit,
		       template (omit) charstring routingIndicator := omit,
		       template (omit) EpsInterworkingIndication epsInterworkingInd := omit,
		       template (omit) boolean indirectForwardingFlag := omit,
		       //template (omit) TS29518_Namf_Communication.NgRanTargetId targetId := omit,
		       template (omit) EpsBearerContextStatus epsBearerCtxStatus := omit) := {
	supi := supi,
	unauthenticatedSupi := unauthenticatedSupi,
	pei := pei,
	gpsi := gpsi,
	pduSessionId := pduSessionId,
	dnn := dnn,
	sNssai := sNssai,
	hplmnSnssai := hplmnSnssai,
	servingNfId := servingNfId,
	guami := guami,
	//serviceName := serviceName,
	servin := servin,
	requestType := requestType,
	n1SmMsg := n1SmMsg,
	anType := anType,
	ratType := ratType,
	presenceInLadn := presenceInLadn,
	ueLocation := ueLocation,
	ueTimeZone := ueTimeZone,
	addUeLocation := addUeLocation,
	smContextStatusUri := smContextStatusUri,
	hSmfUri := hSmfUri,
	additionalHsmfUri := additionalHsmfUri,
	oldPduSessionId := oldPduSessionId,
	pduSessionsActivateList := pduSessionsActivateList,
	ueEpsPdnConnection := ueEpsPdnConnection,
	hoState := hoState,
	pcfId := pcfId,
	nrfUri := nrfUri,
	supportedFeatures := supportedFeatures,
	selMode := selMode,
	backupAmfInfo := backupAmfInfo,
	traceData := traceData,
	udmGroupId := udmGroupId,
	routingIndicator := routingIndicator,
	epsInterworkingInd := epsInterworkingInd,
	indirectForwardingFlag := indirectForwardingFlag,
	//targetId := targetId,
	epsBearerCtxStatus := epsBearerCtxStatus
}

}
