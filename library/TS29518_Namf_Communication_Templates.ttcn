module TS29518_Namf_Communication_Templates {

import from TS29518_Namf_Communication all;


template (present) N1N2MessageTransferReqData
tr_N1N2MessageTransferReqData(template (omit) N1MessageContainer n1MessageContainer := omit,
			      template (omit) N2InfoContainer n2InfoContainer := omit,
			      template (omit) RefToBinaryData mtData := omit,
			      template (omit) boolean skipInd := omit,
			      template (omit) boolean lastMsgIndication := omit,
			      template (omit) PduSessionId pduSessionId := omit,
			      template (omit) CorrelationID lcsCorrelationId := omit,
			      template (omit) LMFIdentification servingLMFIdentification := omit,
			      template (omit) Ppi ppi := omit,
			      template (omit) Arp arp := omit,
			      template (omit) FiveQi fiveqi := omit,
			      template (omit) Uri n1n2FailureTxfNotifURI := omit,
			      template (omit) boolean smfReallocationInd := omit,
			      template (omit) AreaOfValidity areaOfValidity := omit,
			      template (omit) SupportedFeatures supportedFeatures := omit,
			      template (omit) Guami oldGuami := omit,
			      template (omit) boolean maAcceptedInd := omit,
			      template (omit) boolean extBufSupport := omit,
			      template (omit) AccessType targetAccess := omit,
			      template (omit) NfInstanceId nfId := omit,
			      template (omit) boolean pruInd := omit,
			      template (omit) PduSessionPriority pduSessionPrio := omit) := {
	n1MessageContainer := n1MessageContainer,
	n2InfoContainer := n2InfoContainer,
	mtData := mtData,
	skipInd := skipInd,
	lastMsgIndication := lastMsgIndication,
	pduSessionId := pduSessionId,
	lcsCorrelationId := lcsCorrelationId,
	servingLMFIdentification := servingLMFIdentification,
	ppi := ppi,
	arp := arp,
	fiveqi := fiveqi,
	n1n2FailureTxfNotifURI := n1n2FailureTxfNotifURI,
	smfReallocationInd := smfReallocationInd,
	areaOfValidity := areaOfValidity,
	supportedFeatures := supportedFeatures,
	oldGuami := oldGuami,
	maAcceptedInd := maAcceptedInd,
	extBufSupport := extBufSupport,
	targetAccess := targetAccess,
	nfId := nfId,
	pruInd := pruInd,
	pduSessionPrio:= pduSessionPrio
}

template (value) N1N2MessageTransferCause
ts_N1N2MessageTransferCause(N1N2MessageTransferCause_enum enum_val) := {
	enum_val := enum_val
}

template (value) N1N2MessageTransferRspData
ts_N1N2MessageTransferRspData(template (value) N1N2MessageTransferCause cause,
			      template (omit) SupportedFeatures supportedFeatures := omit) := {
	cause := cause,
	supportedFeatures := supportedFeatures
}

}
