module TS29505_Subscription_Data_Templates {

import from JSON_Generic all
import from TS29505_Subscription_Data all;

const charstring c_Nudr_DR_path_api_prefix := "/nudr-dr/v1";

/* "{ueId}" */
template (value) charstring
ts_Nudr_DR_UeId(template (value) charstring imsi) := "imsi-" & valueof(imsi);

template (value) charstring
ts_Nudr_DR_path_subscription_data(template (value) charstring imsi)
:= c_Nudr_DR_path_api_prefix & "/subscription-data/" & valueof(ts_Nudr_DR_UeId(imsi));

template (value) charstring
ts_Nudr_DR_path_authentication_data(template (value) charstring imsi)
:= valueof(ts_Nudr_DR_path_subscription_data(imsi)) & "/authentication-data";

/* 3GPP TS 29.505 5.2.2.3.1 Resource: AuthenticationSubscription */
template (present) charstring
tr_Nudr_DR_path_authentication_subscription(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudr_DR_path_api_prefix & "/subscription-data/imsi-" & imsi & "/authentication-data/authentication-subscription";
template (value) charstring
ts_Nudr_DR_path_authentication_subscription(template (value) charstring imsi)
:= valueof(ts_Nudr_DR_path_authentication_data(imsi)) & "/authentication-subscription";

/* 3GPP TS 29.505 5.2.24.2 */
template (present) charstring
tr_Nudr_DR_path_authentication_status(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudr_DR_path_api_prefix & "/subscription-data/imsi-" & imsi & "/authentication-data/authentication-status";
template (value) charstring
ts_Nudr_DR_path_authentication_status(template (value) charstring imsi)
:= valueof(ts_Nudr_DR_path_authentication_data(imsi)) & "/authentication-status";

template (value) charstring
ts_Nudr_DR_path_context_data(template (value) charstring imsi)
:= valueof(ts_Nudr_DR_path_subscription_data(imsi)) & "/context-data";

template (value) charstring
ts_Nudr_DR_path_amf_3gpp_access(template (value) charstring imsi)
:= valueof(ts_Nudr_DR_path_context_data(imsi)) & "/amf-3gpp-access";

template (value) AuthMethod
ts_AuthMethod(AuthMethod_enum enum_val) := {
	enum_val := enum_val
}

template (value) PatchOperation
ts_PatchOperation(PatchOperation_enum enum_val) := {
	enum_val := enum_val
}

template (value) PlmnId
ts_PlmnId(template (value) Mcc mcc,
	  template (value) Mnc mnc) := {
	mcc := mcc,
	mnc := mnc
}

template (value) PlmnIdNid
ts_PlmnIdNid(template (value) Mcc mcc,
	     template (value) Mnc mnc,
	     template (omit) Nid nid := omit) := {
	mcc := mcc,
	mnc := mnc,
	nid := nid
}

template (value) Guami
ts_Guami(template (value) PlmnIdNid plmnId,
	 template (value) AmfId amfId) := {
	plmnId := plmnId,
	amfId := amfId
}

template (value) RatType
ts_RatType(RatType_enum enum_val) := {
	enum_val := enum_val
}

template (value) PatchItem
ts_PatchItem(template (value) PatchOperation op,
	     template (value) charstring path,
	     template (omit) charstring from_ := omit,
	     template (omit) JSON_Generic.JSON_generic_val value_ := omit) := {
	op := op,
	path := path,
	from_  := from_,
	value_ := value_
}


type TS29505_Subscription_Data.Amf3GppAccessRegistration.backupAmfInfo BackupAmfInfoList;

template (value) Amf3GppAccessRegistration
ts_Amf3GppAccessRegistration(template (value) NfInstanceId amfInstanceId,
			     template (omit) SupportedFeatures supportedFeatures := omit,
			     template (omit) PurgeFlag purgeFlag := omit,
			     template (omit) Pei pei := omit,
			     template (omit) ImsVoPs imsVoPs := omit,
			     template (value) Uri deregCallbackUri,
			     template (omit) ServiceName amfServiceNameDereg := omit,
			     template (omit) Uri pcscfRestorationCallbackUri := omit,
			     template (omit) ServiceName amfServiceNamePcscfRest := omit,
			     template (omit) boolean initialRegistrationInd := omit,
			     template (omit) boolean emergencyRegistrationInd := omit,
			     template (value) Guami guami,
			     template (omit) BackupAmfInfoList backupAmfInfo := omit,
			     template (omit) DualRegistrationFlag drFlag := omit,
			     template (omit) boolean eps5GsMobilityWoN26 := omit,
			     template (value) RatType ratType,
			     template (omit) boolean urrpIndicator := omit,
			     template (omit) Uri amfEeSubscriptionId := omit,
			     template (omit) EpsInterworkingInfo epsInterworkingInfo := omit,
			     template (omit) boolean ueSrvccCapability := omit,
			     template (omit) DateTime registrationTime := omit,
			     template (omit) VgmlcAddress vgmlcAddress := omit,
			     template (omit) ContextInfo contextInfo := omit,
			     template (omit) boolean noEeSubscriptionInd := omit,
			     template (omit) Supi supi := omit,
			     template (omit) UeReachableInd ueReachableInd := omit,
			     template (omit) boolean reRegistrationRequired := omit,
			     template (omit) boolean adminDeregSubWithdrawn := omit,
			     template (omit) Uri dataRestorationCallbackUri := omit,
			     template (omit) record of charstring resetIds := omit,
			     template (omit) boolean disasterRoamingInd := omit,
			     template (omit) boolean ueMINTCapability := omit,
			     template (omit) boolean ueMintEpsCapability := omit,
			     template (omit) boolean sorSnpnSiSupported := omit,
			     template (omit) boolean udrRestartInd := omit,
			     template (omit) DateTime lastSynchronizationTime := omit,
			     template (omit) boolean ueSnpnSubscriptionInd := omit) := {
	amfInstanceId := amfInstanceId,
	supportedFeatures := supportedFeatures,
	purgeFlag := purgeFlag,
	pei := pei,
	imsVoPs := imsVoPs,
	deregCallbackUri := deregCallbackUri,
	amfServiceNameDereg := amfServiceNameDereg,
	pcscfRestorationCallbackUri := pcscfRestorationCallbackUri,
	amfServiceNamePcscfRest := amfServiceNamePcscfRest,
	initialRegistrationInd := initialRegistrationInd,
	emergencyRegistrationInd := emergencyRegistrationInd,
	guami := guami,
	backupAmfInfo := backupAmfInfo,
	drFlag := drFlag,
	eps5GsMobilityWoN26 := eps5GsMobilityWoN26,
	ratType := ratType,
	urrpIndicator := urrpIndicator,
	amfEeSubscriptionId := amfEeSubscriptionId,
	epsInterworkingInfo := epsInterworkingInfo,
	ueSrvccCapability := ueSrvccCapability,
	registrationTime := registrationTime,
	vgmlcAddress := vgmlcAddress,
	contextInfo := contextInfo,
	noEeSubscriptionInd := noEeSubscriptionInd,
	supi := supi,
	ueReachableInd := ueReachableInd,
	reRegistrationRequired := reRegistrationRequired,
	adminDeregSubWithdrawn := adminDeregSubWithdrawn,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	resetIds := resetIds,
	disasterRoamingInd := disasterRoamingInd,
	ueMINTCapability := ueMINTCapability,
	ueMintEpsCapability := ueMintEpsCapability,
	sorSnpnSiSupported := sorSnpnSiSupported,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
	ueSnpnSubscriptionInd := ueSnpnSubscriptionInd
}

template (present) AuthenticationSubscription
tr_AuthenticationSubscription(template (present) AuthMethod authenticationMethod := ?,
			      template charstring encPermanentKey := *,
			      template charstring protectionParameterId := *,
			      template SequenceNumber sequenceNumber := *,
			      template charstring authenticationManagementField := *,
			      template charstring algorithmId := *,
			      template charstring encOpcKey := *,
			      template charstring encTopcKey := *,
			      template boolean vectorGenerationInHss := *,
			      template NfGroupId hssGroupId := *,
			      template AuthMethod n5gcAuthMethod := *,
			      template boolean rgAuthenticationInd := *,
			      template Supi supi := *,
			      template boolean akmaAllowed := *,
			      template charstring routingId := *,
			      template boolean nswoAllowed := *,
			      template boolean fivegKeyHierarSupp := *) := {
	authenticationMethod := authenticationMethod,
	encPermanentKey := encPermanentKey,
	protectionParameterId := protectionParameterId,
	sequenceNumber := sequenceNumber,
	authenticationManagementField := authenticationManagementField,
	algorithmId := algorithmId,
	encOpcKey := encOpcKey,
	encTopcKey := encTopcKey,
	vectorGenerationInHss := vectorGenerationInHss,
	hssGroupId := hssGroupId,
	n5gcAuthMethod := n5gcAuthMethod,
	rgAuthenticationInd := rgAuthenticationInd,
	supi := supi,
	akmaAllowed := akmaAllowed,
	routingId := routingId,
	nswoAllowed := nswoAllowed,
	fivegKeyHierarSupp := fivegKeyHierarSupp
}

