type TS29505_Subscription_Data.SequenceNumber.lastIndexes SequenceNumberIndexesMap;
template (present) SequenceNumber
tr_SequenceNumber(template SqnScheme sqnScheme := *,
		  template charstring sqn := *,
		  template SequenceNumberIndexesMap lastIndexes := *,
		  template integer indLength := *,
		  template Sign difSign := *) := {
	sqnScheme := sqnScheme,
	sqn := sqn,
	lastIndexes := lastIndexes,
	indLength := indLength,
	difSign := difSign
}

