module TS29505_Subscription_Data_Templates {

import from TS29505_Subscription_Data all;

const charstring c_Nudr_DR_path_api_prefix := "/nudr-dr/v1";

template (present) charstring
tr_Nudr_DR_path_authentication_subscription(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudr_DR_path_api_prefix & "/subscription-data/imsi-" & imsi & "/authentication-data/authentication-subscription";

/* 3GPP TS 29.505 5.2.24.2 */
template (present) charstring
tr_Nudr_DR_path_authentication_status(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudr_DR_path_api_prefix & "/subscription-data/imsi-" & imsi & "/authentication-data/authentication-status";

template (value) AuthMethod
ts_AuthMethod(AuthMethod_enum enum_val) := {
	enum_val := enum_val
}

template (present) AuthenticationSubscription
tr_AuthenticationSubscription(template (present) AuthMethod authenticationMethod := ?,
			      template charstring encPermanentKey := *,
			      template charstring protectionParameterId := *,
			      template SequenceNumber sequenceNumber := *,
			      template charstring authenticationManagementField := *,
			      template charstring algorithmId := *,
			      template charstring encOpcKey := *,
			      template charstring encTopcKey := *,
			      template boolean vectorGenerationInHss := *,
			      template NfGroupId hssGroupId := *,
			      template AuthMethod n5gcAuthMethod := *,
			      template boolean rgAuthenticationInd := *,
			      template Supi supi := *,
			      template boolean akmaAllowed := *,
			      template charstring routingId := *,
			      template boolean nswoAllowed := *,
			      template boolean fivegKeyHierarSupp := *) := {
	authenticationMethod := authenticationMethod,
	encPermanentKey := encPermanentKey,
	protectionParameterId := protectionParameterId,
	sequenceNumber := sequenceNumber,
	authenticationManagementField := authenticationManagementField,
	algorithmId := algorithmId,
	encOpcKey := encOpcKey,
	encTopcKey := encTopcKey,
	vectorGenerationInHss := vectorGenerationInHss,
	hssGroupId := hssGroupId,
	n5gcAuthMethod := n5gcAuthMethod,
	rgAuthenticationInd := rgAuthenticationInd,
	supi := supi,
	akmaAllowed := akmaAllowed,
	routingId := routingId,
	nswoAllowed := nswoAllowed,
	fivegKeyHierarSupp := fivegKeyHierarSupp
}

template (value) AuthenticationSubscription
ts_AuthenticationSubscription(template (value) AuthMethod authenticationMethod,
			      template (omit) charstring encPermanentKey := omit,
			      template (omit) charstring protectionParameterId := omit,
			      template (omit) SequenceNumber sequenceNumber := omit,
			      template (omit) charstring authenticationManagementField := omit,
			      template (omit) charstring algorithmId := omit,
			      template (omit) charstring encOpcKey := omit,
			      template (omit) charstring encTopcKey := omit,
			      template (omit) boolean vectorGenerationInHss := omit,
			      template (omit) NfGroupId hssGroupId := omit,
			      template (omit) AuthMethod n5gcAuthMethod := omit,
			      template (omit) boolean rgAuthenticationInd := omit,
			      template (omit) Supi supi := omit,
			      template (omit) boolean akmaAllowed := omit,
			      template (omit) charstring routingId := omit,
			      template (omit) boolean nswoAllowed := omit,
			      template (omit) boolean fivegKeyHierarSupp := omit) := {
	authenticationMethod := authenticationMethod,
	encPermanentKey := encPermanentKey,
	protectionParameterId := protectionParameterId,
	sequenceNumber := sequenceNumber,
	authenticationManagementField := authenticationManagementField,
	algorithmId := algorithmId,
	encOpcKey := encOpcKey,
	encTopcKey := encTopcKey,
	vectorGenerationInHss := vectorGenerationInHss,
	hssGroupId := hssGroupId,
	n5gcAuthMethod := n5gcAuthMethod,
	rgAuthenticationInd := rgAuthenticationInd,
	supi := supi,
	akmaAllowed := akmaAllowed,
	routingId := routingId,
	nswoAllowed := nswoAllowed,
	fivegKeyHierarSupp := fivegKeyHierarSupp
}

type TS29505_Subscription_Data.SequenceNumber.lastIndexes SequenceNumberIndexesMap;
template (value) SequenceNumber
ts_SequenceNumber(template (omit) SqnScheme sqnScheme := omit,
		  template (omit) charstring sqn := omit,
		  template (omit) SequenceNumberIndexesMap lastIndexes := omit,
		  template (omit) integer indLength := omit,
		  template (omit) Sign difSign := omit) := {
	sqnScheme := sqnScheme,
	sqn := sqn,
	lastIndexes := lastIndexes,
	indLength := indLength,
	difSign := difSign
}

template (value) AuthEvent
ts_AuthEvent(template (value) NfInstanceId nfInstanceId,
	     template (value) Success success,
	     template (value) DateTime timeStamp,
	     template (value) AuthType authType,
	     template (value) ServingNetworkName servingNetworkName,
	     template (omit) boolean authRemovalInd := omit,
	     template (omit) NfSetId nfSetId := omit,
	     template (omit) record of charstring resetIds := omit,
	     template (omit) Uri dataRestorationCallbackUri := omit,
	     template (omit) boolean udrRestartInd := omit,
	     template (omit) DateTime lastSynchronizationTime := omit,
	     template (omit) boolean nswoInd := omit) := {
	nfInstanceId := nfInstanceId,
	success := success,
	timeStamp := timeStamp,
	authType := authType,
	servingNetworkName := servingNetworkName,
	authRemovalInd := authRemovalInd,
	nfSetId := nfSetId,
	resetIds := resetIds,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
	nswoInd := nswoInd
}

template (present) AuthEvent
tr_AuthEvent(template (present) NfInstanceId nfInstanceId := ?,
	     template (present) Success success := ?,
	     template (present) DateTime timeStamp := ?,
	     template (present) AuthType authType := ?,
	     template (present) ServingNetworkName servingNetworkName := ?,
	     template boolean authRemovalInd := *,
	     template NfSetId nfSetId := *,
	     template record of charstring resetIds := *,
	     template Uri dataRestorationCallbackUri := *,
	     template boolean udrRestartInd := *,
	     template DateTime lastSynchronizationTime := *,
	     template boolean nswoInd := *) := {
	nfInstanceId := nfInstanceId,
	success := success,
	timeStamp := timeStamp,
	authType := authType,
	servingNetworkName := servingNetworkName,
	authRemovalInd := authRemovalInd,
	nfSetId := nfSetId,
	resetIds := resetIds,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
	nswoInd := nswoInd
}

}
