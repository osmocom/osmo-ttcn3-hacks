ts_AuthEvent(template (value) NfInstanceId nfInstanceId,
	     template (value) Success success,
	     template (value) DateTime timeStamp,
	     template (value) AuthType authType,
	     template (value) ServingNetworkName servingNetworkName,
	     template (omit) boolean authRemovalInd := omit,
	     template (omit) NfSetId nfSetId := omit,
	     template (omit) record of charstring resetIds := omit,
	     template (omit) Uri dataRestorationCallbackUri := omit,
	     template (omit) boolean udrRestartInd := omit,
	     template (omit) DateTime lastSynchronizationTime := omit,
	     template (omit) boolean nswoInd := omit) := {
	nfInstanceId := nfInstanceId,
	success := success,
	timeStamp := timeStamp,
	authType := authType,
	servingNetworkName := servingNetworkName,
	authRemovalInd := authRemovalInd,
	nfSetId := nfSetId,
	resetIds := resetIds,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
	nswoInd := nswoInd
}

template (present) AuthEvent
tr_AuthEvent(template (present) NfInstanceId nfInstanceId := ?,
	     template (present) Success success := ?,
	     template (present) DateTime timeStamp := ?,
	     template (present) AuthType authType := ?,
	     template (present) ServingNetworkName servingNetworkName := ?,
	     template boolean authRemovalInd := *,
	     template NfSetId nfSetId := *,
	     template record of charstring resetIds := *,
	     template Uri dataRestorationCallbackUri := *,
	     template boolean udrRestartInd := *,
	     template DateTime lastSynchronizationTime := *,
	     template boolean nswoInd := *) := {
	nfInstanceId := nfInstanceId,
	success := success,
	timeStamp := timeStamp,
	authType := authType,
	servingNetworkName := servingNetworkName,
	authRemovalInd := authRemovalInd,
	nfSetId := nfSetId,
	resetIds := resetIds,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
