	roamingIndication := roamingIndication,
	homeSnssai := homeSnssai
}

/* Table 6.1.3.2.3.1-1 */
type set NetworkSliceInformationParams {
	NFType nFType,
	NfInstanceId nFInstanceId,
	SliceInfoForRegistration sliceInfoForRegistration optional,
	SliceInfoForPDUSession sliceInfoForPDUSession optional,
	Snssai_list sliceInfoRequestForPdnConnection optional,
	Snssai_list sliceInfoRequestForOtherPurpose optional,
	PlmnId homePlmnId optional,
	Tai tai optional,
	SupportedFeatures supportedFeatures optional
};

template (value) NetworkSliceInformationParams
ts_NetworkSliceInformationParams(
	template (value) NFType nFType,
	template (value) NfInstanceId nFInstanceId,
	template (omit) SliceInfoForRegistration sliceInfoForRegistration := omit,
	template (omit) SliceInfoForPDUSession sliceInfoForPDUSession := omit,
	template (omit) Snssai_list sliceInfoRequestForPdnConnection := omit,
	template (omit) Snssai_list sliceInfoRequestForOtherPurpose := omit,
	template (omit) PlmnId homePlmnId := omit,
	template (omit) Tai tai := omit,
	template (omit) SupportedFeatures supportedFeatures := omit) := {
	nFType := nFType,
	nFInstanceId := nFInstanceId,
	sliceInfoForRegistration := sliceInfoForRegistration,
	sliceInfoForPDUSession := sliceInfoForPDUSession,
	sliceInfoRequestForPdnConnection := sliceInfoRequestForPdnConnection,
	sliceInfoRequestForOtherPurpose := sliceInfoRequestForOtherPurpose,
	homePlmnId := homePlmnId,
	tai := tai,
	supportedFeatures := supportedFeatures
};

function f_enc_NetworkSliceInformationParams(NetworkSliceInformationParams val) return charstring
{
	var charstring nftype := oct2char(f_enc_NFType(val.nFType));
	nftype := substr(nftype, 1, lengthof(nftype) - 2); /* Get rid of quote characters. */
	var charstring enc := "?nf-type=" & nftype;
	enc := enc & "&nf-id=" & val.nFInstanceId;
	if (ispresent(val.sliceInfoForRegistration)) {
		enc := enc & "&slice-info-request-for-registration=" &
		       oct2char(f_enc_SliceInfoForRegistration(val.sliceInfoForRegistration));
	}
	if (ispresent(val.sliceInfoForPDUSession)) {
		enc := enc & "&slice-info-request-for-pdu-session=" &
		       oct2char(f_enc_SliceInfoForPDUSession(val.sliceInfoForPDUSession));
	}
	if (ispresent(val.sliceInfoRequestForPdnConnection)) {
		enc := enc & "&slice-info-request-for-pdn-connection=" &
		       oct2char(f_enc_Snssai_list(val.sliceInfoRequestForPdnConnection));
	}
	if (ispresent(val.sliceInfoRequestForOtherPurpose)) {
		enc := enc & "&slice-info-request-for-pdu-sessionother-purpose=" &
		       oct2char(f_enc_Snssai_list(val.sliceInfoRequestForOtherPurpose));
	}
	if (ispresent(val.homePlmnId)) {
		enc := enc & "&home-plmn-id=" &
		       oct2char(f_enc_PlmnId(val.homePlmnId));
	}
	if (ispresent(val.tai)) {
		enc := enc & "&tai=" &
		       oct2char(f_enc_Tai(val.tai));
	}
	if (ispresent(val.supportedFeatures)) {
		enc := enc & "&supported-features=" &
		       oct2char(f_enc_SupportedFeatures(val.supportedFeatures));
	}
	return enc;
}

