import from TS29531_Nnssf_NSSelection all;

const charstring c_Nnssf_NSSelection_path_api_prefix := "/nnssf-nsselection/v2";

/* 6.1.3.2 Resource: Network Slice Information */
const charstring c_Nnssf_NSSelection_path_net_slice_info
:= c_Nnssf_NSSelection_path_api_prefix & "/network-slice-information";

template (value) NFType
ts_NFType(template (value) NFType_enum enum_val) := {
	enum_val := enum_val
}

template (value) RoamingIndication
ts_RoamingIndication(template (value) RoamingIndication_enum enum_val) := {
	enum_val := enum_val
}

template (value) Snssai
ts_Snssai(template (value) integer sst,
	  template (omit) charstring sd := omit) := {
	sst := sst,
	sd := sd
}

