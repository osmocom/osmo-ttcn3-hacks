type TS29531_Nnssf_NSSelection.AuthorizedNetworkSliceInfo.rejectedNssaiInTa RejectedNssaiInTaList;
type TS29531_Nnssf_NSSelection.AuthorizedNetworkSliceInfo.nrfOauth2Required NrfOauth2RequiredMap;
