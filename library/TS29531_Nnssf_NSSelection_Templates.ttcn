type TS29531_Nnssf_NSSelection.AuthorizedNetworkSliceInfo.nsagInfos NsagInfoList;
type TS29531_Nnssf_NSSelection.AuthorizedNetworkSliceInfo.mappingOfNssai MappingOfNssaiAuthorizedList;
type TS29531_Nnssf_NSSelection.AuthorizedNetworkSliceInfo.snssaiInfoRspData SnssaiInfoRspDataMap;

template (present) AuthorizedNetworkSliceInfo
tr_AuthorizedNetworkSliceInfo(template AllowedNssaiList allowedNssaiList := *,
			      template ConfiguredNssaiList configuredNssai := *,
			      template charstring targetAmfSet := *,
			      template CandidateAmfList candidateAmfList := *,
			      template RejectedNssaiInPlmnList rejectedNssaiInPlmn := *,
			      template RejectedNssaiInTaList rejectedNssaiInTa := *,
			      template NsiInformation nsiInformation := *,
			      template SupportedFeatures supportedFeatures := *,
			      template Uri nrfAmfSet := *,
			      template Uri nrfAmfSetNfMgtUri := *,
			      template Uri nrfAmfSetAccessTokenUri := *,
			      template NrfOauth2RequiredMap nrfOauth2Required := *,
			      template NfServiceSetId targetAmfServiceSet := *,
			      template TargetNssaiList targetNssai := *,
			      template NsagInfoList nsagInfos := *,
			      template MappingOfNssaiAuthorizedList mappingOfNssai := *,
			      template SnssaiInfoRspDataMap snssaiInfoRspData := *) := {
	allowedNssaiList := allowedNssaiList,
	configuredNssai := configuredNssai,
	targetAmfSet := targetAmfSet,
	candidateAmfList := candidateAmfList,
	rejectedNssaiInPlmn := rejectedNssaiInPlmn,
	rejectedNssaiInTa := rejectedNssaiInTa,
	nsiInformation := nsiInformation,
	supportedFeatures := supportedFeatures,
	nrfAmfSet := nrfAmfSet,
	nrfAmfSetNfMgtUri := nrfAmfSetNfMgtUri,
	nrfAmfSetAccessTokenUri := nrfAmfSetAccessTokenUri,
	nrfOauth2Required := nrfOauth2Required,
	targetAmfServiceSet := targetAmfServiceSet,
	targetNssai := targetNssai,
	nsagInfos := nsagInfos,
	mappingOfNssai := mappingOfNssai,
	snssaiInfoRspData := snssaiInfoRspData
}


