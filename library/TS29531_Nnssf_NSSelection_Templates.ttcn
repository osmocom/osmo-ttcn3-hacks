type TS29531_Nnssf_NSSelection.SliceInfoForRegistration.sNssaiForMapping SNssaiForMappingList;
type TS29531_Nnssf_NSSelection.SliceInfoForRegistration.requestedNssai RequestedNssaiList;
template (value) SliceInfoForRegistration
ts_SliceInfoForRegistration(template (omit) SubscribedNssaiList subscribedNssai := omit,
			    template (omit) AllowedNssai allowedNssaiCurrentAccess := omit,
			    template (omit) AllowedNssai allowedNssaiOtherAccess := omit,
			    template (omit) SNssaiForMappingList sNssaiForMapping := omit,
			    template (omit) RequestedNssaiList requestedNssai := omit,
			    template (omit) boolean defaultConfiguredSnssaiInd := omit,
			    template (omit) MappingOfNssaiList mappingOfNssai := omit,
			    template (omit) boolean requestMapping := omit,
			    template (omit) boolean ueSupNssrgInd := omit,
			    template (omit) boolean suppressNssrgInd := omit,
			    template (omit) boolean nsagSupported := omit) := {
	subscribedNssai := subscribedNssai,
	allowedNssaiCurrentAccess := allowedNssaiCurrentAccess,
	allowedNssaiOtherAccess := allowedNssaiOtherAccess,
	sNssaiForMapping := sNssaiForMapping,
	requestedNssai := requestedNssai,
	defaultConfiguredSnssaiInd := defaultConfiguredSnssaiInd,
	mappingOfNssai := mappingOfNssai,
	requestMapping := requestMapping,
	ueSupNssrgInd := ueSupNssrgInd,
	suppressNssrgInd := suppressNssrgInd,
	nsagSupported := nsagSupported
}

template (value) SliceInfoForPDUSession
ts_SliceInfoForPDUSession(template (value) Snssai sNssai,
			  template (value) RoamingIndication roamingIndication,
			  template (omit) Snssai homeSnssai := omit) := {
