module TS29511_N5g_eir_EquipmentIdentityCheck_Templates {

import from TS29511_N5g_eir_EquipmentIdentityCheck all;

const charstring c_N5g_eir_eic_path_api_prefix := "/n5g-eir-eic/v1";

/* 6.1.3.2 Resource: equipmentStatus */
const charstring c_N5g_eir_eic_path_equipment_status
:= c_N5g_eir_eic_path_api_prefix & "/equipment-status";

/* Table 6.1.3.2.3.1-1: URI query parameters supported by the GET method on this resource */
type set EquipmentStatusParameters {
	Pei	pei,
	Supi	supi optional,
	Gpsi	gpsi optional,
	SupportedFeatures supported_features optional
};

template (value) EquipmentStatusParameters
ts_EquipmentStatusParameters(template (value) Pei pei,
			     template (omit) Supi supi := omit,
			     template (omit) Gpsi gpsi := omit,
			     template (omit) SupportedFeatures supported_features := omit) := {
	pei := pei,
	supi := supi,
	gpsi := gpsi,
	supported_features := supported_features
}

function f_enc_EquipmentStatusParameters(EquipmentStatusParameters val) return charstring
{
	var charstring enc := "?pei=" & val.pei;
	if (ispresent(val.supi)) {
		enc := enc & "&supi=" & val.supi;
	}
	if (ispresent(val.gpsi)) {
		enc := enc & "&gpsi=" & val.gpsi;
	}
	if (ispresent(val.supported_features)) {
		enc := enc & "&supported-features=" & val.supported_features;
	}
	return enc;
}

template (present) EirResponseData
tr_EirResponseData(template (present) EquipmentStatus status := ?) := {
	status := status
}

template (value) Pei
ts_Pei_IMEI(template (value) charstring imei)
:= "imei-" & valueof(imei);

template (value) Pei
ts_Pei_IMEISV(template (value) charstring imei)
:= "imeisv-" & valueof(imei);

template (value) Pei
ts_Pei_MAC(template (value) charstring mac,
			    template (value) charstring untrusted := "-untrusted")
:= "mac-" & valueof(mac) & valueof(untrusted);

template (value) Pei
ts_Pei_EUI(template (value) charstring eui)
:= "eui-" & valueof(eui);

template (value) Pei
ts_Supi_IMSI(template (value) charstring imsi)
:= "imsi-" & valueof(imsi);

}
