module TS29519_Policy_Data_Templates {

import from TS29519_Policy_Data all;

const charstring c_Nudr_DR_policy_data_path_api_prefix := "/nudr-dr/v1/policy-data";

template (present) charstring
tr_Nudr_DR_policy_data_path_sm_data(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudr_DR_policy_data_path_api_prefix & "/ues/imsi-" & imsi & "/sm-data*";


template (value) Snssai
ts_Snssai(template (value) integer sst,
	  template (omit) charstring sd := omit) := {
	sst := sst,
	sd := sd
}

type TS29519_Policy_Data.SmPolicyDnnData.spendLimInfo SpendLimInfoMap;
type TS29519_Policy_Data.SmPolicyDnnData.refUmDataLimitIds RefUmDataLimitIdsMap;
type TS29519_Policy_Data.SmPolicyDnnData.praInfos PraInfosMap;
type TS29519_Policy_Data.SmPolicyDnnData.bdtRefIds BdtRefIdsUnion;
type TS29519_Policy_Data.SmPolicyDnnData.tnaps TnapIdList;
type TS29519_Policy_Data.SmPolicyDnnData.restriStatus RestrictedStatusList;
template (value) SmPolicyDnnData
ts_SmPolicyDnnData(template (value) Dnn dnn,
		   template (omit) record of charstring allowedServices := omit,
		   template (omit) record of charstring subscCats := omit,
		   template (omit) BitRate gbrUl := omit,
		   template (omit) BitRate gbrDl := omit,
		   template (omit) boolean adcSupport := omit,
		   template (omit) boolean subscSpendingLimits := omit,
		   template (omit) SpendLimInfoMap spendLimInfo := omit,
		   template (omit) IpIndex ipv4Index := omit,
		   template (omit) IpIndex ipv6Index := omit,
		   template (omit) boolean offline := omit,
		   template (omit) boolean online := omit,
		   template (omit) ChargingInformation chfInfo := omit,
		   template (omit) NfGroupId chfGroupId := omit,
		   template (omit) RefUmDataLimitIdsMap refUmDataLimitIds := omit,
		   template (omit) boolean mpsPriority := omit,
		   template (omit) boolean mcsPriority := omit,
		   template (omit) boolean imsSignallingPrio := omit,
		   template (omit) integer mpsPriorityLevel := omit,
		   template (omit) integer mcsPriorityLevel := omit,
		   template (omit) PraInfosMap praInfos := omit,
		   template (omit) BdtRefIdsUnion bdtRefIds := omit,
		   template (omit) boolean locRoutNotAllowed := omit,
		   template (omit) boolean sfcNotAllowed := omit,
		   template (omit) TnapIdList tnaps := omit,
		   template (omit) RestrictedStatusList restriStatus := omit,
		   template (omit) boolean headerNotAllowed := omit) := {
	dnn := dnn,
	allowedServices := allowedServices,
	subscCats := subscCats,
	gbrUl := gbrUl,
	gbrDl := gbrDl,
	adcSupport := adcSupport,
	subscSpendingLimits := subscSpendingLimits,
	spendLimInfo := spendLimInfo,
	ipv4Index := ipv4Index,
	ipv6Index := ipv6Index,
	offline := offline,
	online := online,
	chfInfo := chfInfo,
	chfGroupId := chfGroupId,
	refUmDataLimitIds := refUmDataLimitIds,
	mpsPriority := mpsPriority,
	mcsPriority := mcsPriority,
	imsSignallingPrio := imsSignallingPrio,
	mpsPriorityLevel := mpsPriorityLevel,
	mcsPriorityLevel := mcsPriorityLevel,
	praInfos := praInfos,
	bdtRefIds := bdtRefIds,
	locRoutNotAllowed := locRoutNotAllowed,
	sfcNotAllowed := sfcNotAllowed,
	tnaps := tnaps,
	restriStatus := restriStatus,
	headerNotAllowed := headerNotAllowed
}

type TS29519_Policy_Data.SmPolicySnssaiData.smPolicyDnnData SmPolicyDnnDataMap;
template (value) SmPolicySnssaiData
ts_SmPolicySnssaiData(template (value) Snssai snssai,
		      template (omit) SmPolicyDnnDataMap smPolicyDnnData := omit,
		      template (omit) SliceMbr ueSliceMbr := omit) := {
	snssai := snssai,
	smPolicyDnnData := smPolicyDnnData,
	ueSliceMbr := ueSliceMbr
}

type TS29519_Policy_Data.SmPolicyData.smPolicySnssaiData SmPolicySnssaiDataMap;
type TS29519_Policy_Data.SmPolicyData.umDataLimits UmDataLimitsMap;
type TS29519_Policy_Data.SmPolicyData.umData UmDataMap;
template (value) SmPolicyData
ts_SmPolicyData(template (value) SmPolicySnssaiDataMap smPolicySnssaiData,
		template (omit) UmDataLimitsMap umDataLimits := omit,
		template (omit) UmDataMap umData := omit,
		template (omit) SupportedFeatures suppFeat := omit) := {
	smPolicySnssaiData := smPolicySnssaiData,
	umDataLimits := umDataLimits,
	umData := umData,
	suppFeat := suppFeat
}

}
