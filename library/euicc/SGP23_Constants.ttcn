/* eUICC Constants in TTCN-3
 *
 * This module implements a set of constants which are used by the eUICC related templates provided in this directory.
 *
 * The constants follow the naming scheme of the SGP.23 test specification and wherever possible the constant values
 * also match the contents as specified. Unfortunately SGP.23 does not specify expected values for dynamic content,
 * even though in many test situations constants would be sufficient. For that reason, this module also defines a
 * constant for each of those dynamic content values as well.
 *
 * Author: Philipp Maier <pmaier@sysmocom.de> / sysmocom - s.f.m.c. GmbH
 *
 * Released under the terms of GNU General Public License, Version 2 or
 * (at your option) any later version.
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

module SGP23_Constants {

/* Generic Constants (see also: SGP.23, annex A, section A1) */
const octetstring SGP23_EID1 := '89049032123451234512345678901235'O;
const octetstring SGP23_EID2 := '89049032112341234012345678901375'O;
const record of octetstring SGP23_EUICC_CI_PK_ID_LIST_FOR_SIGNING_1 :=
	{'C0BC70BA36929D43B467FF57570530E57AB8FCD8'O, 'F54172BDF98A95D65CBEB88A38A1C11D800A85C3'O};
const record of octetstring SGP23_EUICC_CI_PK_ID_LIST_FOR_VERIFICATION_1 :=
	{'C0BC70BA36929D43B467FF57570530E57AB8FCD8'O, 'F54172BDF98A95D65CBEB88A38A1C11D800A85C3'O};
function f_SGP23_ACTIVATION_CODE_1(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_1) return charstring {
	return "1$#" & test_dp_address & "$" & matching_id;
}
function f_SGP23_ACTIVATION_CODE_2(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_2,
			     charstring sm_dp_oid := "foo") return charstring {
	return "1$#" & test_dp_address & "$" & matching_id & "$" & sm_dp_oid;
}
function f_SGP23_ACTIVATION_CODE_3(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_3) return charstring {
	return "1$#" & test_dp_address & "$" & matching_id & "$$1";
}
function f_SGP23_ACTIVATION_CODE_3_NO_CC(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_3) return charstring {
	return f_SGP23_ACTIVATION_CODE_1(test_dp_address, matching_id);
}
function f_SGP23_ACTIVATION_CODE_4(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_4) return charstring {
	return f_SGP23_ACTIVATION_CODE_1(test_dp_address, matching_id);
}
function f_SGP23_ACTIVATION_CODE_5(charstring test_dp_address := SGP23_TEST_DP_ADDRESS1,
	 		     charstring matching_id := SGP23_MATCHING_ID_EMPTY) return charstring {
	return f_SGP23_ACTIVATION_CODE_1(test_dp_address, matching_id);
}
