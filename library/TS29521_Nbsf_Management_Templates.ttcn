module TS29521_Nbsf_Management_Templates {

import from TS29521_Nbsf_Management all;

const charstring c_Nbsf_Management_path_api_prefix := "/nbsf-management/v1";
const charstring c_Nbsf_Management_path_pcfBindings
:= c_Nbsf_Management_path_api_prefix & "/pcfBindings";

const charstring c_Nbsf_Management_path_pcf_ue_bindings
:= c_Nbsf_Management_path_api_prefix & "/pcf-ue-bindings";

/* 5.3.3 Resource: Individual PCF for a PDU Session Binding */
template (value) charstring
ts_Nbsf_Management_path_individual_pcf_pdu_sess_binding(template (value) charstring binding_id)
:= c_Nbsf_Management_path_pcfBindings & "/" & valueof(binding_id);

/* 5.3.8 Resource: Individual PCF for a UE Binding */
template (value) charstring
ts_Nbsf_Management_path_individual_pcf_ue_binding(template (value) charstring binding_id)
:= c_Nbsf_Management_path_pcf_ue_bindings & "/" & valueof(binding_id);

template (value) Snssai
ts_Snssai(template (value) integer sst,
	  template (omit) charstring sd := omit) := {
	sst := sst,
	sd := sd
}

template (value) IpEndPoint
ts_IpEndPoint(template (omit) Ipv4Addr ipv4Address := omit,
	      template (omit) Ipv6Addr ipv6Address := omit,
	      template (omit) TransportProtocol transport := omit,
	      template (omit) integer port_ := omit) := {
	ipv4Address := ipv4Address,
	ipv6Address := ipv6Address,
	transport := transport,
	port_ :=  port_
}

type TS29521_Nbsf_Management.PcfBinding.addIpv6Prefixes Ipv6PrefixList;
type TS29521_Nbsf_Management.PcfBinding.addMacAddrs MacAddr48List;
type TS29521_Nbsf_Management.PcfBinding.pcfIpEndPoints PcfIpEndPointList;
type TS29521_Nbsf_Management.PcfBinding.pcfSmIpEndPoints PcfSmIpEndPointList;
type TS29521_Nbsf_Management.PcfBinding.ipv4FrameRouteList Ipv4FrameRouteList;
type TS29521_Nbsf_Management.PcfBinding.ipv6FrameRouteList Ipv6FrameRouteList;

template (present) PcfBinding
tr_PcfBinding(template Supi supi := *,
	      template Gpsi gpsi := *,
	      template Ipv4Addr ipv4Addr := *,
	      template Ipv6Prefix ipv6Prefix := *,
	      template Ipv6PrefixList addIpv6Prefixes := *,
	      template charstring ipDomain := *,
	      template MacAddr48 macAddr48 := *,
	      template MacAddr48List addMacAddrs := *,
	      template (present) Dnn dnn := ?,
	      template Fqdn pcfFqdn := *,
	      template PcfIpEndPointList pcfIpEndPoints := *,
	      template DiameterIdentity pcfDiamHost := *,
	      template DiameterIdentity pcfDiamRealm := *,
	      template Fqdn pcfSmFqdn := *,
	      template PcfSmIpEndPointList pcfSmIpEndPoints := *,
	      template (present) Snssai snssai := ?,
	      template SupportedFeatures suppFeat := *,
	      template NfInstanceId pcfId := *,
	      template NfSetId pcfSetId := *,
	      template DateTime recoveryTime := *,
	      template ParameterCombination paraCom := *,
	      template BindingLevel bindLevel := *,
	      template Ipv4FrameRouteList ipv4FrameRouteList := *,
	      template Ipv6FrameRouteList ipv6FrameRouteList := *) := {
	supi := supi,
	gpsi := gpsi,
	ipv4Addr := ipv4Addr,
	ipv6Prefix := ipv6Prefix,
	addIpv6Prefixes := addIpv6Prefixes,
	ipDomain := ipDomain,
	macAddr48 := macAddr48,
	addMacAddrs := addMacAddrs,
	dnn := dnn,
	pcfFqdn := pcfFqdn,
	pcfIpEndPoints := pcfIpEndPoints,
	pcfDiamHost := pcfDiamHost,
	pcfDiamRealm := pcfDiamRealm,
	pcfSmFqdn := pcfSmFqdn,
	pcfSmIpEndPoints := pcfSmIpEndPoints,
	snssai := snssai,
	suppFeat := suppFeat,
	pcfId := pcfId,
	pcfSetId := pcfSetId,
	recoveryTime := recoveryTime,
	paraCom := paraCom,
	bindLevel := bindLevel,
	ipv4FrameRouteList := ipv4FrameRouteList,
	ipv6FrameRouteList := ipv6FrameRouteList
}

template (value) PcfBinding
ts_PcfBinding(
	      template (omit) Supi supi := omit,
	      template (omit) Gpsi gpsi := omit,
	      template (omit) Ipv4Addr ipv4Addr := omit,
	      template (omit) Ipv6Prefix ipv6Prefix := omit,
	      template (omit) Ipv6PrefixList addIpv6Prefixes := omit,
	      template (omit) charstring ipDomain := omit,
	      template (omit) MacAddr48 macAddr48 := omit,
	      template (omit) MacAddr48List addMacAddrs := omit,
	      template (value) Dnn dnn,
	      template (omit) Fqdn pcfFqdn := omit,
	      template (omit) PcfIpEndPointList pcfIpEndPoints := omit,
	      template (omit) DiameterIdentity pcfDiamHost := omit,
	      template (omit) DiameterIdentity pcfDiamRealm := omit,
	      template (omit) Fqdn pcfSmFqdn := omit,
	      template (omit) PcfSmIpEndPointList pcfSmIpEndPoints := omit,
	      template (value) Snssai snssai,
	      template (omit) SupportedFeatures suppFeat := omit,
	      template (omit) NfInstanceId pcfId := omit,
	      template (omit) NfSetId pcfSetId := omit,
	      template (omit) DateTime recoveryTime := omit,
	      template (omit) ParameterCombination paraCom := omit,
	      template (omit) BindingLevel bindLevel := omit,
	      template (omit) Ipv4FrameRouteList ipv4FrameRouteList := omit,
	      template (omit) Ipv6FrameRouteList ipv6FrameRouteList := omit) := {
	supi := supi,
	gpsi := gpsi,
	ipv4Addr := ipv4Addr,
	ipv6Prefix := ipv6Prefix,
	addIpv6Prefixes := addIpv6Prefixes,
	ipDomain := ipDomain,
	macAddr48 := macAddr48,
	addMacAddrs := addMacAddrs,
	dnn := dnn,
	pcfFqdn := pcfFqdn,
	pcfIpEndPoints := pcfIpEndPoints,
	pcfDiamHost := pcfDiamHost,
	pcfDiamRealm := pcfDiamRealm,
	pcfSmFqdn := pcfSmFqdn,
	pcfSmIpEndPoints := pcfSmIpEndPoints,
	snssai := snssai,
	suppFeat := suppFeat,
	pcfId := pcfId,
	pcfSetId := pcfSetId,
	recoveryTime := recoveryTime,
	paraCom := paraCom,
	bindLevel := bindLevel,
	ipv4FrameRouteList := ipv4FrameRouteList,
	ipv6FrameRouteList := ipv6FrameRouteList
}

type TS29521_Nbsf_Management.PcfForUeBinding.pcfForUeIpEndPoints PcfForUeIpEndPointList;

template (present) PcfForUeBinding
tr_PcfForUeBinding(template (present) Supi supi := ?,
		   template Gpsi gpsi := *,
		   template Fqdn pcfForUeFqdn := *,
		   template PcfForUeIpEndPointList pcfForUeIpEndPoints := *,
		   template NfInstanceId pcfId := *,
		   template DateTime recoveryTime := *,
		   template NfSetId pcfSetId := *,
		   template BindingLevel bindLevel := *,
		   template SupportedFeatures suppFeat := *) := {
	supi := supi,
	gpsi := gpsi,
	pcfForUeFqdn := pcfForUeFqdn,
	pcfForUeIpEndPoints := pcfForUeIpEndPoints,
	pcfId := pcfId,
	recoveryTime := recoveryTime,
	pcfSetId := pcfSetId,
	bindLevel := bindLevel,
	suppFeat := suppFeat
}

template (value) PcfForUeBinding
ts_PcfForUeBinding(template (value) Supi supi,
		   template (omit) Gpsi gpsi := omit,
		   template (omit) Fqdn pcfForUeFqdn := omit,
		   template (omit) PcfForUeIpEndPointList pcfForUeIpEndPoints := omit,
		   template (omit) NfInstanceId pcfId := omit,
		   template (omit) DateTime recoveryTime := omit,
		   template (omit) NfSetId pcfSetId := omit,
		   template (omit) BindingLevel bindLevel := omit,
		   template (omit) SupportedFeatures suppFeat := omit) := {
	supi := supi,
	gpsi := gpsi,
	pcfForUeFqdn := pcfForUeFqdn,
	pcfForUeIpEndPoints := pcfForUeIpEndPoints,
	pcfId := pcfId,
	recoveryTime := recoveryTime,
	pcfSetId := pcfSetId,
	bindLevel := bindLevel,
	suppFeat := suppFeat
}

}
