module TS29521_Nbsf_Management_Templates {

import from TS29521_Nbsf_Management all;

const charstring c_Nbsf_Management_path_api_prefix := "/nbsf-management/v1";
const charstring c_Nbsf_Management_path_pcfBindings
:= c_Nbsf_Management_path_api_prefix & "/pcfBindings";

/* 5.3.3 Resource: Individual PCF for a PDU Session Binding */
template (value) charstring
ts_Nbsf_Management_path_individual_pcf_pdu_sess_binding(template (value) charstring binding_id)
:= c_Nbsf_Management_path_pcfBindings & "/" & valueof(binding_id);

type TS29521_Nbsf_Management.PcfBinding.addIpv6Prefixes Ipv6PrefixList;
type TS29521_Nbsf_Management.PcfBinding.addMacAddrs MacAddr48List;
type TS29521_Nbsf_Management.PcfBinding.pcfIpEndPoints PcfIpEndPointList;
type TS29521_Nbsf_Management.PcfBinding.pcfSmIpEndPoints PcfSmIpEndPointList;
type TS29521_Nbsf_Management.PcfBinding.ipv4FrameRouteList Ipv4FrameRouteList;
type TS29521_Nbsf_Management.PcfBinding.ipv6FrameRouteList Ipv6FrameRouteList;
template (present) PcfBinding
tr_PcfBinding(template Supi supi := *,
	      template Gpsi gpsi := *,
	      template Ipv4Addr ipv4Addr := *,
	      template Ipv6Prefix ipv6Prefix := *,
	      template Ipv6PrefixList addIpv6Prefixes := *,
	      template charstring ipDomain := *,
	      template MacAddr48 macAddr48 := *,
	      template MacAddr48List addMacAddrs := *,
	      template (present) Dnn dnn := ?,
	      template Fqdn pcfFqdn := *,
	      template PcfIpEndPointList pcfIpEndPoints := *,
	      template DiameterIdentity pcfDiamHost := *,
	      template DiameterIdentity pcfDiamRealm := *,
	      template Fqdn pcfSmFqdn := *,
	      template PcfSmIpEndPointList pcfSmIpEndPoints := *,
	      template (present) Snssai snssai := ?,
	      template SupportedFeatures suppFeat := *,
	      template NfInstanceId pcfId := *,
	      template NfSetId pcfSetId := *,
	      template DateTime recoveryTime := *,
	      template ParameterCombination paraCom := *,
	      template BindingLevel bindLevel := *,
	      template Ipv4FrameRouteList ipv4FrameRouteList := *,
	      template Ipv6FrameRouteList ipv6FrameRouteList := *) := {
	supi := supi,
	gpsi := gpsi,
	ipv4Addr := ipv4Addr,
	ipv6Prefix := ipv6Prefix,
	addIpv6Prefixes := addIpv6Prefixes,
	ipDomain := ipDomain,
	macAddr48 := macAddr48,
	addMacAddrs := addMacAddrs,
	dnn := dnn,
	pcfFqdn := pcfFqdn,
	pcfIpEndPoints := pcfIpEndPoints,
	pcfDiamHost := pcfDiamHost,
	pcfDiamRealm := pcfDiamRealm,
	pcfSmFqdn := pcfSmFqdn,
	pcfSmIpEndPoints := pcfSmIpEndPoints,
	snssai := snssai,
	suppFeat := suppFeat,
	pcfId := pcfId,
	pcfSetId := pcfSetId,
	recoveryTime := recoveryTime,
	paraCom := paraCom,
	bindLevel := bindLevel,
	ipv4FrameRouteList := ipv4FrameRouteList,
	ipv6FrameRouteList := ipv6FrameRouteList
}

}
