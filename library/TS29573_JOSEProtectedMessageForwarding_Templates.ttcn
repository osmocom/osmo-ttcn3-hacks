module TS29573_JOSEProtectedMessageForwarding_Templates {


import from JSON_Generic all;
import from TS29573_JOSEProtectedMessageForwarding all;

/* 6.2 JOSE Protected Message Forwarding API on N32 */
const charstring c_N32f_Forward_path_api_prefix := "/n32f-forward/v1";

/* 6.2.4.2 Operation: JOSE Protected Forwarding */
const charstring c_N32f_Forward_path_n32f_process
:= c_N32f_Forward_path_api_prefix & "/n32f-process";


template (value) FlatJweJson
ts_FlatJweJson(template (omit) charstring protected := omit,
	       template (omit) JSON_Generic.JSON_generic_val unprotected := omit,
	       template (omit) JSON_Generic.JSON_generic_val header := omit,
	       template (omit) charstring encrypted_key := omit,
	       template (omit) charstring aad := omit,
	       template (omit) charstring iv := omit,
	       template (value) charstring ciphertext,
	       template (omit) charstring tag := omit) := {
	protected := protected,
	unprotected := unprotected,
	header := header,
	encrypted_key := encrypted_key,
	aad := aad,
	iv := iv,
	ciphertext := ciphertext,
	tag := tag
}

type TS29573_JOSEProtectedMessageForwarding.N32fReformattedReqMsg.modificationsBlock FlatJwsJsonReqList;
template (present) N32fReformattedReqMsg
tr_N32fReformattedReqMsg(template (present) FlatJweJson reformattedData := ?,
			 template FlatJwsJsonReqList modificationsBlock := *) := {
	reformattedData := reformattedData,
	modificationsBlock := modificationsBlock
}
template (value) N32fReformattedReqMsg
ts_N32fReformattedReqMsg(template (value) FlatJweJson reformattedData,
			 template (omit) FlatJwsJsonReqList modificationsBlock := omit) := {
	reformattedData := reformattedData,
	modificationsBlock := modificationsBlock
}

type TS29573_JOSEProtectedMessageForwarding.N32fReformattedRspMsg.modificationsBlock FlatJwsJsonRspList;
template (present) N32fReformattedRspMsg
tr_N32fReformattedRspMsg(template (present) FlatJweJson reformattedData := ?,
			 template FlatJwsJsonRspList modificationsBlock := *) := {
	reformattedData := reformattedData,
	modificationsBlock := modificationsBlock
}
template (value) N32fReformattedRspMsg
ts_N32fReformattedRspMsg(template (value) FlatJweJson reformattedData,
			 template (omit) FlatJwsJsonRspList modificationsBlock := omit) := {
	reformattedData := reformattedData,
	modificationsBlock := modificationsBlock
}

}
