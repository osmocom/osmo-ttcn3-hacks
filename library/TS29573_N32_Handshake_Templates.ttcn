module TS29573_N32_Handshake_Templates {

import from TS29573_N32_Handshake all;

const charstring c_N32_Handshake_path_api_prefix := "/n32c-handshake/v1";

/* 6.1.4.2 Operation: Security Capability Negotiation */
const charstring c_N32_Handshake_path_sec_cap_neg
:= c_N32_Handshake_path_api_prefix & "/exchange-capability";

/* 6.1.4.3 Operation: Parameter Exchange */
const charstring c_N32_Handshake_path_exchange_params
:= c_N32_Handshake_path_api_prefix & "/exchange-params";

template (value) PlmnId
ts_PlmnId(template (value) Mcc mcc,
	  template (value) Mnc mnc) := {
	mcc := mcc,
	mnc := mnc
}

template (present) SecurityCapability
tr_SecurityCapability(template (present) SecurityCapability_enum enum_val := ?) := {
	enum_val := enum_val
}
template (value) SecurityCapability
ts_SecurityCapability(template (value) SecurityCapability_enum enum_val) := {
	enum_val := enum_val
}

type TS29573_N32_Handshake.SecNegotiateReqData.supportedSecCapabilityList SupportedSecCapabilityList;
type TS29573_N32_Handshake.SecNegotiateReqData.plmnIdList SecNegotiateReqDataPlmnIdList;
type TS29573_N32_Handshake.SecNegotiateReqData.snpnIdList SecNegotiateReqDataPlmnIdNidList;
type TS29573_N32_Handshake.SecNegotiateReqData.senderN32fPortList SenderN32fPortList;
type TS29573_N32_Handshake.SecNegotiateReqData.intendedUsagePurpose IntendedN32PurposeList;
template (present) SecNegotiateReqData
tr_SecNegotiateReqData(template (present) Fqdn sender_ := ?,
		      template charstring n32HandshakeId := *,
		      template (present) SupportedSecCapabilityList supportedSecCapabilityList := ?,
		      template boolean threeGppSbiTargetApiRootSupported := *,
		      template SecNegotiateReqDataPlmnIdList plmnIdList := *,
		      template SecNegotiateReqDataPlmnIdNidList snpnIdList := *,
		      template PlmnId targetPlmnId := *,
		      template PlmnIdNid targetSnpnId := *,
		      template IntendedN32PurposeList intendedUsagePurpose := *,
		      template SupportedFeatures supportedFeatures := *,
		      template Fqdn senderN32fFqdn := *,
		      template SenderN32fPortList senderN32fPortList := *,
		      template DurationSec n32KeepaliveTimer := *) := {
	sender_ := sender_,
	n32HandshakeId := n32HandshakeId,
	supportedSecCapabilityList := supportedSecCapabilityList,
	threeGppSbiTargetApiRootSupported := threeGppSbiTargetApiRootSupported,
	plmnIdList := plmnIdList,
	snpnIdList := snpnIdList,
	targetPlmnId := targetPlmnId,
	targetSnpnId := targetSnpnId,
	intendedUsagePurpose := intendedUsagePurpose,
	supportedFeatures := supportedFeatures,
	senderN32fFqdn := senderN32fFqdn,
	senderN32fPortList := senderN32fPortList,
	n32KeepaliveTimer := n32KeepaliveTimer

}
template (value) SecNegotiateReqData
ts_SecNegotiateReqData(template (value) Fqdn sender_,
		      template (omit) charstring n32HandshakeId := omit,
		      template (value) SupportedSecCapabilityList supportedSecCapabilityList,
		      template (omit) boolean threeGppSbiTargetApiRootSupported := omit,
		      template (omit) SecNegotiateReqDataPlmnIdList plmnIdList := omit,
		      template (omit) SecNegotiateReqDataPlmnIdNidList snpnIdList := omit,
		      template (omit) PlmnId targetPlmnId := omit,
		      template (omit) PlmnIdNid targetSnpnId := omit,
		      template (omit) IntendedN32PurposeList intendedUsagePurpose := omit,
		      template (omit) SupportedFeatures supportedFeatures := omit,
		      template (omit) Fqdn senderN32fFqdn := omit,
		      template (omit) SenderN32fPortList senderN32fPortList := omit,
		      template (omit) DurationSec n32KeepaliveTimer := omit) := {
	sender_ := sender_,
	n32HandshakeId := n32HandshakeId,
	supportedSecCapabilityList := supportedSecCapabilityList,
	threeGppSbiTargetApiRootSupported := threeGppSbiTargetApiRootSupported,
	plmnIdList := plmnIdList,
	snpnIdList := snpnIdList,
	targetPlmnId := targetPlmnId,
	targetSnpnId := targetSnpnId,
	intendedUsagePurpose := intendedUsagePurpose,
	supportedFeatures := supportedFeatures,
	senderN32fFqdn := senderN32fFqdn,
	senderN32fPortList := senderN32fPortList,
	n32KeepaliveTimer := n32KeepaliveTimer

}

