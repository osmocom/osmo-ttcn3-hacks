const charstring c_Npcf_SMPolicyControl_path_api_prefix := "/npcf-smpolicycontrol/v1";

/* 5.3.2 Resource: SM Policies */
const charstring c_Npcf_SMPolicyControl_path_sm_policies := c_Npcf_SMPolicyControl_path_api_prefix & "/sm-policies";

/* 5.3.3 Resource: Individual SM Policy */
template (value) charstring
ts_Npcf_SMPolicyControl_path_individual_sm_policy(template (value) charstring sm_policy_id)
:= c_Npcf_SMPolicyControl_path_sm_policies & "/" & valueof(sm_policy_id);


template (present) charstring
tr_Npcf_SMPolicyControl_path_individual_sm_policy_delete(template (present) charstring sm_policy_id := pattern "?+")
:= pattern c_Npcf_SMPolicyControl_path_sm_policies & "/" & sm_policy_id & "/delete";


