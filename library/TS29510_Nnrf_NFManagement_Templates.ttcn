:= c_Nnrf_NFM_path_api_prefix & "/nf-instances";

template (present) charstring tr_Nnrf_NFM_path_nf_instance(template (present) charstring nf_instance_id := pattern "?+")
:= pattern c_Nnrf_NFM_path_nf_instances & "/" & nf_instance_id;
template (value) charstring ts_Nnrf_NFM_path_nf_instance(template (value) charstring nf_instance_id)
:= c_Nnrf_NFM_path_nf_instances & "/" & valueof(nf_instance_id);

