module TS29503_Nudm_UECM_Templates {

import from TS29503_Nudm_UECM all;

const charstring c_Nudm_UECM_path_api_prefix := "/nudm-uecm/v1";

/* 6.2.3.2 Resource: Amf3GppAccessRegistration (Document) */
template (present) charstring
tr_Nudm_UECM_path_amf_3gpp_registration(template (present) charstring imsi := pattern "\d+")
:= pattern c_Nudm_UECM_path_api_prefix & "/imsi-" & imsi & "/registrations/amf-3gpp-access";
template (value) charstring
ts_Nudm_UECM_path_amf_3gpp_registration(template (value) charstring imsi)
:= c_Nudm_UECM_path_api_prefix & "/imsi-" & valueof(imsi) & "/registrations/amf-3gpp-access"

/* 6.2.3.5 Resource: IndividualSmfRegistration */
template (present) charstring
tr_Nudm_UECM_path_individual_smf_registration(template (present) charstring imsi := pattern "\d+",
					      template (present) charstring smf_reg := pattern "\d+")
:= pattern c_Nudm_UECM_path_api_prefix & "/imsi-" & imsi & "/registrations/smf-registrations/" & smf_reg;

template (value) charstring
ts_Nudm_UECM_path_individual_smf_registration(template (value) charstring imsi,
					      template (value) charstring smf_reg)
:= c_Nudm_UECM_path_api_prefix & "/imsi-" & valueof(imsi) & "/registrations/smf-registrations/" & valueof(smf_reg);

/* 6.2.6.2.2 */
