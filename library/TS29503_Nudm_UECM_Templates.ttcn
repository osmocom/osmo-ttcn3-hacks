module TS29503_Nudm_UECM_Templates {

import from TS29503_Nudm_UECM all;

template (present) SmfRegistration
tr_SmfRegistration(template (present) NfInstanceId smfInstanceId := ?,
		   template NfSetId smfSetId := *,
		   template SupportedFeatures supportedFeatures := *,
		   template (present) PduSessionId pduSessionId := ?,
		   template (present) Snssai singleNssai := ?,
		   template Dnn dnn := *,
		   template boolean emergencyServices := *,
		   template Uri pcscfRestorationCallbackUri := *,
		   template (present) PlmnId plmnId := ?,
		   template Fqdn pgwFqdn := *,
		   template IpAddress pgwIpAddr := *,
		   template boolean epdgInd := *,
		   template Uri deregCallbackUri := *,
		   template RegistrationReason registrationReason := *,
		   template DateTime registrationTime := *,
		   template ContextInfo contextInfo := *,
		   template NfInstanceId pcfId := *,
		   template Uri dataRestorationCallbackUri := *,
		   template record of charstring resetIds := *,
		   template boolean udrRestartInd := *,
		   template DateTime lastSynchronizationTime := *,
		   template boolean pduSessionReActivationRequired := *,
		   template Uri staleCheckCallbackUri := *,
		   template Uri udmStaleCheckCallbackUri := *,
		   template boolean wildcardInd := *) := {
	smfInstanceId:= smfInstanceId,
	smfSetId := smfSetId,
	supportedFeatures := supportedFeatures,
	pduSessionId:= pduSessionId,
	singleNssai:= singleNssai,
	dnn := dnn,
	emergencyServices := emergencyServices,
	pcscfRestorationCallbackUri := pcscfRestorationCallbackUri,
	plmnId:= plmnId,
	pgwFqdn := pgwFqdn,
	pgwIpAddr := pgwIpAddr,
	epdgInd := epdgInd,
	deregCallbackUri := deregCallbackUri,
	registrationReason := registrationReason,
	registrationTime := registrationTime,
	contextInfo := contextInfo,
	pcfId := pcfId,
	dataRestorationCallbackUri := dataRestorationCallbackUri,
	resetIds := resetIds,
	udrRestartInd := udrRestartInd,
	lastSynchronizationTime := lastSynchronizationTime,
	pduSessionReActivationRequired := pduSessionReActivationRequired,
	staleCheckCallbackUri := staleCheckCallbackUri,
	udmStaleCheckCallbackUri := udmStaleCheckCallbackUri,
	wildcardInd := wildcardInd
}

}
