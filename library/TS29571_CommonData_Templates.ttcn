module TS29571_CommonData_Templates {

import from TS29571_CommonData all;

/* 3GPP TS 29.571 Table 5.3.2-1 Supi from "SupiOrSuci": */
template (value) charstring
ts_sbi_Supi(template (value) charstring imsi) := "imsi-" & valueof(imsi);

template (value) PlmnIdNid
ts_PlmnIdNid(template (value) Mcc mcc,
	     template (value) Mnc mnc,
	     template (omit) Nid nid := omit) := {
	mcc := mcc,
	mnc := mnc,
	nid := nid
}

}
