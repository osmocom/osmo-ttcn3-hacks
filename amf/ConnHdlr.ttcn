					g_pars.ue_pars.amf_id,
					g_pars.ue_pars.ran_id)));
}

/* 3GPP TS 38.413 9.2.2.16 9.2.2.19 UE CONTEXT RESUME REQUEST
 * 3GPP TS 23.502 4.8.2.3 Connection Resume procedure */
function f_ue_context_resume() runs on ConnHdlr
{
