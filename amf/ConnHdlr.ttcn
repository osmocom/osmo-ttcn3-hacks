function f_Nnrf_NFM_wait_all_post_subscriptions()
runs on ConnHdlr {
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_NFtype(SEPP));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(nausf_auth));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(nudm_uecm));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(nudm_sdm));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(npcf_am_policy_control));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(nsmf_pdusession));
	as_Nnrf_NFM_post_subscriptions(subscrCond := tr_SubscrCond1_ServiceName(nnssf_nsselection));
}

/***********************************************************************
 * N12 Nausf_UEAuthentication (SBI): Emulated AUSF, 3GPP TS 29.509 A.2
 ***********************************************************************/
const charstring c_Nausf_uri_hostport := mp_scp_local_ip & ":" & int2str(mp_scp_local_port);
const charstring c_Nausf_uri_prefix := "http://" & c_Nausf_uri_hostport;

template (value) charstring
ts_Nausf_UEAuthentication_uri_individual_ue_authentication(template (value) charstring auth_ctx_id)
:= c_Nausf_uri_prefix & valueof(ts_Nausf_UEAuthentication_path_individual_ue_authentication(auth_ctx_id));

template (value) charstring
ts_Nausf_UEAuthentication_uri_5g_aka_confirmation(template (value) charstring auth_ctx_id)
:= c_Nausf_uri_prefix & valueof(ts_Nausf_UEAuthentication_path_5g_aka_confirmation(auth_ctx_id));

/* 3GPP TS 29.509 6.1.3.2.3.1 Resource: ue-authentications (POST) */
function f_tr_Nausf_UEAuth_post_ue_authentications(template (present) AuthenticationInfo auth_info := ?)
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "POST",
						      path := c_Nausf_UEAuthentication_path_ue_authentications);
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := decmatch auth_info));
	return http2_msg;
}

/* 3GPP TS 29.509 6.1.3.2.3.1 Resource: ue-authentications (POST) */
altstep as_Nausf_UEAuth_post_ue_authentications(template (present) AuthenticationInfo auth_info := ?, boolean force_resync := false)
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_Nausf_UEAuth_post_ue_authentications(auth_info := auth_info)) -> value http2_rx {
		var template (value) UEAuthenticationCtx ue_auth_ctx;
		var octetstring body_enc;
		var template (value) HTTP2_Msg http2_tx;
		var charstring aka_link := valueof(ts_Nausf_UEAuthentication_uri_5g_aka_confirmation(int2str(g_pars.ue_pars.idx)));
		var template (value) Av5gAka auth_tuple;
		if (force_resync) {
			auth_tuple := ts_Av5gAka(rand := "989412c4f4b4795cbc294ed80f9dc7f6",
						 hxresStar := "5411b6b758e8296200af5633d56ca6f8",
						 autn := "20502291734f80000863a380878aa310");
		} else {
			auth_tuple := ts_Av5gAka(rand := "ec68e3268268c43be673e6155c6c7713",
						 hxresStar := "54ecc70258d97fef1dbce4cb217961ec",
						 autn := "7812bbcc5fc78000825b6d1aae174f7b");
		}
		ue_auth_ctx := ts_UEAuthenticationCtx(authType := ts_AuthType(FiveG_AKA),
						      fivegAuthData := ts_FivegAuthDataUnion_Av5gAka(auth_tuple),
						      links := { {"5g-aka", ts_LinksValueSchema(ts_Link(aka_link))} });
		body_enc := f_enc_UEAuthenticationCtx(valueof(ue_auth_ctx));

		http2_tx := ts_HTTP2_Msg_201_Created(http2_rx.conn_id,
						     http2_rx.stream_id,
						     headers := {
							ts_HTTP2_Hdr_content_type("application/json"),
							ts_HTTP2_Hdr_location(ts_Nausf_UEAuthentication_uri_individual_ue_authentication(int2str(g_pars.ue_pars.idx)))
						     },
						     body := ts_HTTP2_Data_frame(http2_rx.stream_id,
										 end_stream_flag := true,
										 data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}

/* 3GPP TS 29.509 6.1.3.3.3.1 Resource: 5g-aka-confirmation (PUT) */
function f_tr_Nausf_UEAuth_put_5g_aka_confirmation(template (present) ConfirmationData conf_data := tr_ConfirmationData())
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "PUT",
						      path := ts_Nausf_UEAuthentication_path_5g_aka_confirmation(int2str(g_pars.ue_pars.idx)));
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := decmatch conf_data));
	return http2_msg;
}

/* 3GPP TS 29.509 6.1.3.3.3.1 Resource: 5g-aka-confirmation (PUT) */
altstep as_Nausf_UEAuth_put_5g_aka_confirmation(AuthResult auth_result)
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_Nausf_UEAuth_put_5g_aka_confirmation()) -> value http2_rx {
		var template (value) ConfirmationDataResponse conf_data_rsp;
		var octetstring body_enc;
		var template (value) HTTP2_Msg http2_tx;
		select (auth_result) {
		case (AUTHENTICATION_SUCCESS) {
			conf_data_rsp := ts_ConfirmationDataResponse(authResult := auth_result,
								     supi := "imsi-" & g_pars.ue_pars.imsi_str,
								     kseaf := "5b5bac11884c1952b4e578ee5eff7da04aae634d314b5daf3966c761d8833e07");
			}
		case (AUTHENTICATION_FAILURE) {
			conf_data_rsp := ts_ConfirmationDataResponse(authResult := auth_result)
			}
		}

		body_enc := f_enc_ConfirmationDataResponse(valueof(conf_data_rsp));

		/* 3GPP TS 29.503 Table 6.3.3.2.4.2.2-2 */
		http2_tx := ts_HTTP2_Msg_200_OK(http2_rx.conn_id,
						http2_rx.stream_id,
						headers := {
							ts_HTTP2_Hdr_content_type("application/json")
						},
						body := ts_HTTP2_Data_frame(http2_rx.stream_id,
									    end_stream_flag := true,
									    data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}


