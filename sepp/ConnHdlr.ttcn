const charstring c_Nnrf_uri_hostport := mp_scp_local_ip & ":" & int2str(mp_scp_local_port);
const charstring c_Nnrf_uri_prefix := "http://" & c_Nnrf_uri_hostport;

/* 6.1.3.2 Resource: nf-instances (Store) (GET) */
function f_tr_Nnrf_NFM_get_nf_instances()
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "GET",
						      path := c_Nnrf_NFM_path_nf_instances);
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := omit);
	return http2_msg;
}

/* 6.1.3.2 Resource: nf-instances (Store) (GET) */
altstep as_Nnrf_NFM_get_nf_instances()
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_Nnrf_NFM_get_nf_instances()) -> value http2_rx {
		var template (value) UriList1 uri_list;
		var octetstring body_enc;
		var template (value) HTTP2_Msg http2_tx;

		uri_list := ts_UriList1(links := { {"item", ts_LinksValueSchema1(ts_Link1("heyval"))} });
		body_enc := f_enc_UriList1(valueof(uri_list));

		http2_tx := ts_HTTP2_Msg_200_OK(http2_rx.conn_id,
						http2_rx.stream_id,
						headers := {
							ts_HTTP2_Hdr_content_type("application/json")
						},
						body := ts_HTTP2_Data_frame(http2_rx.stream_id,
									    end_stream_flag := true,
									    data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}

/* 6.1.3.3 Resource: nf-instance (PUT) */
function f_tr_Nnrf_NFM_put_nf_instance()
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "PUT",
						      path := tr_Nnrf_NFM_path_nf_instance);
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := decmatch tr_NFProfile1));
	return http2_msg;
}

/* 6.1.3.3 Resource: nf-instance (PUT) */
altstep as_Nnrf_NFM_put_nf_instance()
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_Nnrf_NFM_put_nf_instance()) -> value http2_rx {
		var NFProfile1 profile;
		var octetstring body_enc;
		var template (value) HTTP2_Msg http2_tx;

		f_dec_NFProfile1(http2_rx.body.data, profile); // TODO: check rc
		profile.plmnList := { valueof(ts_PlmnId1(mcc := mp_sepp_plmn_mcc, mnc := mp_sepp_plmn_mnc)) };
		body_enc := f_enc_NFProfile1(profile);

		http2_tx := ts_HTTP2_Msg_201_Created(http2_rx.conn_id,
						     http2_rx.stream_id,
						     headers := {
							ts_HTTP2_Hdr_content_type("application/json")
						     },
						     body := ts_HTTP2_Data_frame(http2_rx.stream_id,
										 end_stream_flag := true,
										 data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}

/****************************************************
 * SBI Emulated NF, 3GPP TS 29.573
 ****************************************************/
const charstring c_sbi_uri_hostport := mp_sepp_sbi_hostname & ":" & int2str(mp_sepp_sbi_port);
const charstring c_sbi_uri_prefix := "http://" & c_sbi_uri_hostport;
const charstring c_sbi_uri_fqdn := "http://5gc.mnc" & mp_sepp_local_plmn_mnc & ".mcc" & mp_sepp_local_plmn_mcc & ".3gppnetwork.org";

const charstring c_HTTP2_HDR_3Gpp_Sbi_Target_apiRoot := "3gpp-sbi-target-apiroot";

/* Test msg to be forwarded:*/
const charstring c_Nudr_DR_path := "/nudr-dr/v1/subscription-data/imsi-345645645433/authentication-data/authentication-subscription";

/* Prepare some sample msg to be forwarded by the IUT SEPP
 * payload: (3GPP TS 29.505 5.2.2.3.1 Resource: AuthenticationSubscription (GET)) */
function f_n35_prepare_get_authentication_subscription()
runs on ConnHdlr return HTTP2_Msg {
	var integer http2_idx := f_http2_adapter_find_free_idx();
	var integer http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	var template (value) HTTP2_Msg http2_tx;

	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "GET",
										      scheme := "http",
										      authority := c_sbi_uri_hostport,
										      path := c_Nudr_DR_path),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-udm"),
						ts_HTTP2_Hdr_accept_encoding("gzip"),
						ts_HTTP2_header_field(c_HTTP2_HDR_3Gpp_Sbi_Target_apiRoot, c_sbi_uri_fqdn)
					}
				 });
	return valueof(http2_tx);
}


}
