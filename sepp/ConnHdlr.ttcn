const integer HTTP2_CONN_SCP := 0;
const integer HTTP2_CONN_SEPP := 1;

/* These are a preset of path matches which can be applied through the entire lifecycle of the session: */
function f_http2_server_path_match_scp()
runs on ConnHdlr return charstring {
	var charstring nf_instance_match := c_Nnrf_NFM_path_nf_instances & "/?+";
	var charstring match_ := "(" & c_Nnrf_NFM_path_nf_instances & ")|(" & nf_instance_match & ")";
	return match_;
}

function f_http2_server_path_match_sepp()
runs on ConnHdlr return charstring {
	var charstring match_n32c := c_N32_Handshake_path_sec_cap_neg;
	var charstring match_n32f := "/nudr-dr/v1/subscription-data/?+";
	var charstring match_ := "(" & match_n32c & ")|(" & match_n32f & ")"
	return match_;
}

type record ConnHdlrPars {
	integer idx,
	charstring fqdn_sender,
	charstring n32f_context_id
}

type component ConnHdlr extends HTTP2_CT, HTTP2_ConnHdlr, Prometheus_Checker_CT {
	var ConnHdlrPars g_pars;
}

type function void_fn() runs on ConnHdlr;

function f_ConnHdlrPars(integer idx := 0) return ConnHdlrPars
{
	var template (value) ConnHdlrPars pars := {
		idx := idx,
		fqdn_sender := "sepp2.localdomain",
		n32f_context_id := int2str(idx) /* 3GPP TS 29.573 Table 6.2.5.2.9-1 n32fContextId */
	};
	return valueof(pars);
}

function f_ConnHdlr_init(void_fn fn, ConnHdlrPars pars) runs on ConnHdlr {
	/* make parameters available via component variable */
	g_pars := pars;

	/* Setup */
	/* Register SCP HTTP2 sever, where IUT will send all SBI requests: */
	f_http2_server_emu_register(f_http2_server_path_match_scp(), idx := HTTP2_CONN_SCP);
	f_http2_server_emu_register(f_http2_server_path_match_sepp(), idx := HTTP2_CONN_SEPP);
	f_http2_adapter_init();

	fn.apply();

	/* Cleanup */
}

function f_http2_adapter_connect_sepp_n32c(integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect(mp_sepp_n32c_hostname, mp_sepp_n32c_port, mp_sepp_local_ip, idx := idx);
}

function f_http2_adapter_connect_send_sepp_n32c(template (value) HTTP2_Msg http2_msg, integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect_sepp_n32c(idx := idx);
	f_http2_adapter_send(http2_msg);
}

function f_http2_adapter_connect_sepp_n32f(integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect(mp_sepp_n32f_hostname, mp_sepp_n32f_port, mp_sepp_local_ip, idx := idx);
}

function f_http2_adapter_connect_send_sepp_n32f(template (value) HTTP2_Msg http2_msg, integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect_sepp_n32f(idx := idx);
	f_http2_adapter_send(http2_msg);
}

function f_http2_adapter_connect_sepp_sbi(integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect(mp_sepp_sbi_hostname, mp_sepp_sbi_port, mp_sepp_local_ip, idx := idx);
}

function f_http2_adapter_connect_send_sepp_sbi(template (value) HTTP2_Msg http2_msg, integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect_sepp_sbi(idx := idx);
	f_http2_adapter_send(http2_msg);
}

