const charstring SCP_uri_prefix := "http://" & SCP_uri_hostport;

/****************************************************
 * N32-c (SBI) Emulated SEPP, 3GPP TS 29.573
 ****************************************************/
const charstring c_N32c_uri_hostport := mp_sepp_n32c_hostname & ":" & int2str(mp_sepp_n32c_port);
const charstring c_N32c_uri_prefix := "http://" & c_N32c_uri_hostport;

/* 6.1.4.2.2 Operation: Security Capability Negotiation (POST) */
function f_tr_N32_Handshake_post_sec_cap_neg()
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "POST",
						      path := c_N32_Handshake_path_sec_cap_neg);
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := decmatch tr_SecNegotiateReqData));
	return http2_msg;
}

/* 6.1.4.2.2 Operation: Security Capability Negotiation (POST) */
altstep as_N32_Handshake_post_sec_cap_neg(template (value) SecurityCapability_enum selected_sec_cap := TLS)
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SEPP].receive(f_tr_N32_Handshake_post_sec_cap_neg()) -> value http2_rx {
		var SecNegotiateReqData req;
		var template (value) SecNegotiateRspData rsp;
		var octetstring body_enc;
		var template (value) HTTP2_Msg http2_tx;

		f_dec_SecNegotiateReqData(http2_rx.body.data, req); // TODO: check rc
		rsp := ts_SecNegotiateRspData(sender_ := g_pars.fqdn_sender,
					      selectedSecCapability := ts_SecurityCapability(selected_sec_cap),
					      plmnIdList := { ts_PlmnId(mcc := mp_sepp_local_plmn_mcc,
									mnc := mp_sepp_local_plmn_mnc) });
		body_enc := f_enc_SecNegotiateRspData(valueof(rsp));

		http2_tx := ts_HTTP2_Msg_200_OK(http2_rx.conn_id,
						http2_rx.stream_id,
						headers := {
							ts_HTTP2_Hdr_content_type("application/json")
						},
						body := ts_HTTP2_Data_frame(http2_rx.stream_id,
									    end_stream_flag := true,
									    data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SEPP].send(http2_tx);
		setverdict(pass);
	}
}

/* 6.1.4.2.2 Operation: Security Capability Negotiation (POST) */
private function f_N32_Handshake_prepare_post_sec_cap_neg(SecNegotiateReqData sec_neg_req)
runs on ConnHdlr return HTTP2_Msg {
	var octetstring sec_neg_req_enc;
	var integer http2_idx;
	var integer http2_stream_id;
	var template (value) HTTP2_Msg http2_tx;

	sec_neg_req_enc := f_enc_SecNegotiateReqData(sec_neg_req);

	http2_idx := f_http2_adapter_find_free_idx();
	http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := c_N32c_uri_hostport,
										      path := c_N32_Handshake_path_sec_cap_neg),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-sepp"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := sec_neg_req_enc));
	return valueof(http2_tx);
}

/* 6.1.4.2 Operation: Security Capability Negotiation */
function f_N32_Handshake_post_sec_cap_neg(template (value) SecurityCapability_enum sec_cap := NONE)
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;
	var template (value) SecNegotiateReqData sec_neg_req;

	sec_neg_req := ts_SecNegotiateReqData(sender_ := g_pars.fqdn_sender,
					      supportedSecCapabilityList := { ts_SecurityCapability(sec_cap) },
					      plmnIdList := { ts_PlmnId(mcc := mp_sepp_local_plmn_mcc,
									mnc := mp_sepp_local_plmn_mnc) } );

	http2_tx := f_N32_Handshake_prepare_post_sec_cap_neg(valueof(sec_neg_req));
	f_http2_adapter_connect_send_sepp_n32c(http2_tx, idx := http2_tx.conn_id);

	/* 3GPP TS 29.521 Table 5.3.2.3.1-3 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := decmatch tr_SecNegotiateRspData(sender_ := mp_sepp_fqdn_sender,
											 selectedSecCapability := tr_SecurityCapability(sec_cap))));
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

/* 6.1.4.3 Operation: Parameter Exchange */
private function f_N32_Handshake_prepare_post_exchange_params(SecParamExchReqData param_exch_req)
runs on ConnHdlr return HTTP2_Msg {
	var octetstring param_exch_req_enc;
	var integer http2_idx;
	var integer http2_stream_id;
	var template (value) HTTP2_Msg http2_tx;

	param_exch_req_enc := f_enc_SecParamExchReqData(param_exch_req);

	http2_idx := f_http2_adapter_find_free_idx();
	http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := c_N32c_uri_hostport,
										      path := c_N32_Handshake_path_exchange_params),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-sepp"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := param_exch_req_enc));
	return valueof(http2_tx);
}

/* 6.1.4.3 Operation: Parameter Exchange */
function f_N32_Handshake_post_exchange_params()
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;
	var template (value) SecParamExchReqData param_exch_req;

	param_exch_req := ts_SecParamExchReqData(n32fContextId := g_pars.n32f_context_id,
						 sender_ := g_pars.fqdn_sender);

	http2_tx := f_N32_Handshake_prepare_post_exchange_params(valueof(param_exch_req));
	f_http2_adapter_connect_send_sepp_n32c(http2_tx, idx := http2_tx.conn_id);

	/* 3GPP TS 29.521 Table 5.3.2.3.1-3 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := decmatch tr_SecParamExchRspData(n32fContextId := g_pars.n32f_context_id,
											 sender_ := mp_sepp_fqdn_sender)));
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

/****************************************************
 * N32-f (SBI) Emulated SEPP, 3GPP TS 29.573 5.3 Message Forwarding Procedure on N32 (N32-f)
 ****************************************************/
const charstring c_N32f_uri_hostport := mp_sepp_n32f_hostname & ":" & int2str(mp_sepp_n32f_port);
const charstring c_N32f_uri_prefix := "http://" & c_N32f_uri_hostport;

/* 5.3.2.4 Message Forwarding to Peer SEPP */
private function f_N32f_Forward_prepare_post_forward(N32fReformattedReqMsg req)
runs on ConnHdlr return HTTP2_Msg {
	var octetstring req_enc;
	var integer http2_idx;
	var integer http2_stream_id;
	var template (value) HTTP2_Msg http2_tx;

	req_enc := f_enc_N32fReformattedReqMsg(req);

	http2_idx := f_http2_adapter_find_free_idx();
	http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := c_N32f_uri_hostport,
										      path := c_N32f_Forward_path_n32f_process),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-sepp"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := req_enc));
	return valueof(http2_tx);
}


/* 5.3.2.4 Message Forwarding to Peer SEPP */
function f_N32f_Forward_post_forward()
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;
	var template (value) N32fReformattedReqMsg req;

	req := ts_N32fReformattedReqMsg(reformattedData := ts_FlatJweJson(ciphertext := "foobar"),
					modificationsBlock := omit);

	http2_tx := f_N32f_Forward_prepare_post_forward(valueof(req));
	f_http2_adapter_connect_send_sepp_sbi(http2_tx, idx := http2_tx.conn_id);

	/* 3GPP TS 29.573 Table 6.2.4.2.2-2 */
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := decmatch tr_N32fReformattedRspMsg()));
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

/* Receive content of f_n35_get_authentication_subscription() forwarded by the IUT SEPP to our emulated SEPP: */
/* 6.1.3.2 Resource: nf-instances (Store) (GET) */
function f_tr_receive_forwarded_traffic()
runs on ConnHdlr return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "GET",
						      path := c_Nudr_DR_path);
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := omit);
	return http2_msg;
}
altstep as_N32f_receive_forwarded_traffic(template (present) HTTP2_Msg http2_exp)
runs on ConnHdlr {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SEPP].receive(http2_exp) -> value http2_rx {
		var template (value) HTTP2_Msg http2_tx;

		http2_tx := ts_HTTP2_Msg_200_OK(http2_rx.conn_id,
						http2_rx.stream_id,
						headers := {
							ts_HTTP2_Hdr_content_type("application/json")
						},
						body := omit);
		HTTP2_CONN[HTTP2_CONN_SEPP].send(http2_tx);
		setverdict(pass);
	}
}


