module SEPP_Tests {

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from TCCEncoding_Functions all;

import from HTTP2_Templates all;
import from HTTP2_Msg all;
import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from ConnHdlr all;

modulepar {
	charstring mp_sepp_sbi_hostname := "127.0.1.250";
	integer	mp_sepp_sbi_port := 7777;

	charstring mp_sepp_n32c_hostname := "127.0.1.251";
	integer	mp_sepp_n32c_port := 7777;

	charstring mp_sepp_n32f_hostname := "127.0.0.252";
	integer	mp_sepp_n32f_port := 7777;

	charstring mp_sepp_fqdn_sender := "sepp1.localdomain";
	charstring mp_sepp_plmn_mcc := "002";
	charstring mp_sepp_plmn_mnc := "001";

	charstring mp_scp_local_ip := "127.0.0.200";
	integer mp_scp_local_port := 7777;

	/* IP address at which we listen for HTTP2/SBI to emulate a SEPP in ttcn3 */
	charstring mp_sepp_local_ip := "127.0.0.10";
	integer mp_sepp_local_port := 7777;

	charstring mp_sepp_local_plmn_mcc := "456";
	charstring mp_sepp_local_plmn_mnc := "123";
}

type component MTC_CT extends HTTP2_CT, HTTP2_ConnHdlr {
	/* emulated SCP */
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_SCP;
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_SEPP;

	timer g_Tguard := 30.0;
}

private function f_init_http2_srv(charstring id) runs on MTC_CT {
	id := id & "-HTTP2SRV";

	var Http2ServerEmulationCfg http2_srv_cfg := {
		http2_bind_ip := mp_scp_local_ip,
		http2_bind_port := mp_scp_local_port,
		one_req_per_conn := false
	};
	vc_HTTP2_SRV_SCP := HTTP2_Server_Emulation_CT.create(id & "-SCP") alive;
	vc_HTTP2_SRV_SCP.start(HTTP2_Server_Emulation.main(http2_srv_cfg));

	http2_srv_cfg := {
			http2_bind_ip := mp_sepp_local_ip,
			http2_bind_port := mp_sepp_local_port,
			one_req_per_conn := false
	};
	vc_HTTP2_SRV_SEPP := HTTP2_Server_Emulation_CT.create(id & "-SEPP") alive;
	vc_HTTP2_SRV_SEPP.start(HTTP2_Server_Emulation.main(http2_srv_cfg));


	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_SEPP], vc_HTTP2_SRV_SEPP:CONN_PROC);
}


private function f_init(integer imsi_suffix := 0, float t_guard := 30.0) runs on MTC_CT {
	var charstring id := testcasename();

	g_Tguard.start(t_guard);
	activate(as_Tguard());

	f_init_http2_srv(id);
}

private function f_shutdown() runs on MTC_CT {
	f_http2_server_close_conn_all(idx := HTTP2_CONN_SCP);
	f_http2_server_close_conn_all(idx := HTTP2_CONN_SEPP);
	setverdict(pass);
}

private function f_start_handler_create()
runs on MTC_CT return ConnHdlr
{
	var ConnHdlr vc_conn;
	var charstring id := testcasename();

	vc_conn := ConnHdlr.create(id);

	if (isbound(vc_HTTP2_SRV_SCP)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
	}

	if (isbound(vc_HTTP2_SRV_SEPP)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_SEPP], vc_HTTP2_SRV_SEPP:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_SEPP], vc_HTTP2_SRV_SEPP:CONN_PROC);
	}

	return vc_conn;
}

private function f_start_handler_run(ConnHdlr vc_conn, void_fn fn, ConnHdlrPars pars) runs on MTC_CT
{
	vc_conn.start(f_ConnHdlr_init(fn, pars));
}

/* start a connection handler with given parameters */
private function f_start_handler(void_fn fn, ConnHdlrPars pars)
runs on MTC_CT return ConnHdlr {
	var ConnHdlr vc_conn;
	vc_conn := f_start_handler_create();
	f_start_handler_run(vc_conn, fn, pars);
	return vc_conn;
}

private altstep as_Tguard() runs on MTC_CT {
	[] g_Tguard.timeout {
		Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, "Tguard timeout");
	}
}

private function f_TC_security_cap_negotiation_none() runs on ConnHdlr {
	f_N32_Handshake_post_sec_cap_neg(NONE);
	setverdict(pass);
}
testcase TC_security_cap_negotiation_none() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_security_cap_negotiation_none), pars);
	vc_conn.done;
	f_shutdown();
}

private function f_TC_security_cap_negotiation_tls() runs on ConnHdlr {
	f_N32_Handshake_post_sec_cap_neg(TLS);
	f_N32_Handshake_post_sec_cap_neg(NONE);
	setverdict(pass);
}
testcase TC_security_cap_negotiation_tls() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_security_cap_negotiation_tls), pars);
	vc_conn.done;
	f_shutdown();
}

private function f_TC_security_cap_negotiation_prins() runs on ConnHdlr {
	f_N32_Handshake_post_sec_cap_neg(PRINS);
	f_N32_Handshake_post_exchange_params();
	setverdict(pass);
}
testcase TC_security_cap_negotiation_prins() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_security_cap_negotiation_prins), pars);
	vc_conn.done;
	f_shutdown();
}

private function f_TC_security_cap_negotiation_server() runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	as_Nnrf_NFM_put_nf_instance();
	as_Nnrf_NFM_get_nf_instances();
	as_N32_Handshake_post_sec_cap_neg();

	/* Test NF sendig data through IUT c-SEPP to our emulated SEPP and back: */
	http2_tx := f_n35_prepare_get_authentication_subscription();
	f_http2_adapter_connect_send_sepp_sbi(http2_tx, idx := http2_tx.conn_id);

	/* emulated p-SEPP receives the traffic emulates forwarding to local NF and forwards back the answer: */
	as_N32f_receive_forwarded_traffic(f_tr_receive_forwarded_traffic());

	/* IUT SEPP forwards the answer back to the originator inside its PLMN: */
	http2_exp_rx :=	tr_HTTP2_Msg(http2_tx.conn_id,
				     http2_tx.stream_id,
				     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
				     omit);
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}
testcase TC_security_cap_negotiation_server() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_security_cap_negotiation_server), pars);
	vc_conn.done;
	f_shutdown();
}

private function f_TC_psepp_n32f_forward() runs on ConnHdlr {
	f_N32_Handshake_post_sec_cap_neg(TLS);
	f_N32f_Forward_post_forward();
	/* TODO: make sure the message is forwarded to an internal PLMN NF as a result.
	 * N32-f Forwarding is not yet implemented in open5gs-seppd. */
	setverdict(pass);
}
testcase TC_psepp_n32f_forward() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_psepp_n32f_forward), pars);
	vc_conn.done;
	f_shutdown();
}

control {
	execute( TC_security_cap_negotiation_none() );
	execute( TC_security_cap_negotiation_tls() );
	execute( TC_security_cap_negotiation_prins() );
	execute( TC_security_cap_negotiation_server() );
	execute( TC_psepp_n32f_forward() );
}

}
