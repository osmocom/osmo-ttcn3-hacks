import from Osmocom_Types all;
import from Native_Functions all;
import from Misc_Helpers all;

import from GTPv1U_Templates all;
import from GTPv1U_CodecPort all;
import from GTPv1U_Emulation all;
import from GTPv2_Types all;
import from GTPv2_Templates all;
import from GTPv2_Emulation all;

import from IP_Types all;
import from ICMPv6_Types all;
import from ICMPv6_Templates all;

import from DIAMETER_Types all;
import from DIAMETER_Templates all;
import from DIAMETER_Emulation all;

import from NG_NAS_TypeDefs all;

import from PFCP_Types all;
import from PFCP_Emulation all;
import from PFCP_Templates all;
import from PFCP_CodecPort all;

import from NTP_Functions all;

import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from Mutex all;

import from SMF_Session_CT_4G all;
import from SMF_Session_CT_5G all;
import from SMF_Tests all;

modulepar {
	HEX15n mp_imsi := '999700000000000'H;
}

const OCT8 c_SEID0 := '0000000000000000'O;

/* per-session component; we typically have 1..N per testcase */
type component SMF_Session_CT extends GTP2_ConnHdlr, GTP1U_ConnHdlr, DIAMETER_ConnHdlr,
				      PFCP_ConnHdlr, MutexCT, HTTP2_CT, HTTP2_ConnHdlr {
	var SessionPars	g_pars;

	/* Address allocation */
	var OCT4	g_ip4_addr;
	var OCT8	g_ip6_interface_id;
	var OCT16	g_ip6_addr;

	/* Store last received Gy message */
	var PDU_DIAMETER g_rx_gy;
}

type record SessionParsGy {
	/* In seconds. 0 => disabled, !0 => grant over CC-Time period */
	integer validity_time,

	/* Result-Code to use when sending Gy CCA, usually DIAMETER_SUCCESS */
	DIAMETER_Resultcode cca_res_code
};

type record BearerConfig {
	 /* EPS Bearer ID */
	uint4_t		ebi optional,
	/* TEI (Data) local side */
	OCT4 		teid_local optional,
	/* TEI (Data) remote side */
	OCT4 		teid_remote optional
};

type record FTeids {
	F_TEID local,
	F_TEID remote optional
}
template (value) FTeids t_FTeids(template (value) F_TEID local,
				 template (omit) F_TEID remote) := {
	local := local,
	remote := remote
}

/* 'local' and 'remote' refer to the GTP information from the UPF's point of view:
 * HNB                             UPF                 CN
 * access.remote <---> access.local | core.local <---> core.remote
 */
type record Gtp1uParameters {
	FTeids core,
	FTeids access,
	FTeids cp
}
template (value) Gtp1uParameters
t_Gtp1uParameters_default(uint32_t idx := 0,
			  charstring mp_pfcp_ip_local) := {
	core := {
		local := ts_PFCP_F_TEID_ipv4(int2oct(idx + 1 + 8192, 4),
					     f_inet_addr(mp_pfcp_ip_local)),
		remote := omit
	},
	access := {
		local := ts_PFCP_F_TEID_ipv4(int2oct(idx + 1, 4),
					     f_inet_addr(mp_pfcp_ip_local)),
		remote := omit
	},
	cp := {
		local := ts_PFCP_F_TEID_ipv4(int2oct(idx + 1 + 16384, 4),
					     f_inet_addr(mp_pfcp_ip_local)),
		remote := omit
	}
}

type record Session_URR {
	URR_ID urr_id,
	integer ur_seqn,
	integer start_time, /* In system clock */
	integer last_report_time, /* In system clock */
	/* Relative to last report sent: */
	uint64_t ul_bytes,
	uint64_t dl_bytes,
	uint64_t ul_pkts,
	uint64_t dl_pkts
}
type record of Session_URR Session_URR_List;
template (value) Session_URR
ts_Session_URR(template (value) URR_ID urr_id, integer start_time) := {
	urr_id := urr_id,
	ur_seqn := 0,
	start_time := start_time,
	last_report_time := start_time,
	ul_bytes := 0,
	dl_bytes := 0,
	ul_pkts := 0,
	dl_pkts := 0
}
type record PfcpParameters {
	charstring pfcp_local_addr,
	Node_ID local_node_id,
	F_SEID local_f_seid,
	F_SEID remote_cp_f_seid optional,
	Session_URR_List urr_list optional,
	Gtp1uParameters gtp1u_pars
}


function f_t_PfcpParams(uint32_t idx := 0,
			charstring pfcp_local_addr := mp_pfcp_ip_local,
			template (value) Node_ID local_node_id := ts_PFCP_Node_ID_ipv4(f_inet_addr(mp_pfcp_ip_local)))
return PfcpParameters {
	var uint64_t local_f_seid := idx + 1;
	var template (value) PfcpParameters pfcp_pars := {
		pfcp_local_addr := pfcp_local_addr,
		local_node_id := local_node_id,
		local_f_seid := ts_PFCP_F_SEID_ipv4(f_inet_addr(pfcp_local_addr), int2oct(local_f_seid, 8)),
		remote_cp_f_seid := omit,
		urr_list := omit,
		gtp1u_pars := t_Gtp1uParameters_default(idx, pfcp_local_addr)
	}
	return valueof(pfcp_pars);
}

type record SessionPars_Namf {
	integer pdu_sess_id,
	charstring ran_gtpu_ip,
	OCT4 ran_gtpu_teid,
	charstring cn_gtpu_ip optional,
	OCT4 cn_gtpu_teid optional,
	charstring ue_ip4 optional,
	charstring ue_ip6 optional,
	octetstring ipv6_interface_id optional

};

type record SessionPars_Npcf {
	charstring sm_policy_id
};

type record SessionPars_Nsmf {
	charstring smContextRef optional
};

type record SessionPars_Nudm {
	charstring smf_subscription_id
};

type record SessionPars_NGNAS {
	OCT1 pti,
	QoS_RuleList qos_rules optional
};

/* configuration data for a given Session */
type record SessionPars {
	hexstring	imsi,
	charstring	imsi_str,
	hexstring	msisdn optional,
	// serving network
	GTP2C_RAT_Type	rat_type,
	// flags?
	charstring	apn,
	/* Apn subscribed or non-subscribed */
	boolean		selection_mode,
	GTP2C_PDN_Type	pdn_type,
	/* PAA */
	/* Max APN Restriction */
	/* APN-AMBR */
	octetstring	pco optional,
	octetstring	epco optional,

	/* TEI (Control) local side */
	OCT4 		teic_local,
	/* TEI (Control) remote side */
	OCT4 		teic_remote optional,
	/* Bearer Contexts to be created */
	BearerConfig 	bearer optional,

	SessionParsGy gy,

	PfcpParameters pfcp_pars,

	SessionPars_Namf namf,
	SessionPars_Npcf npcf,
	SessionPars_Nsmf nsmf,
	SessionPars_Nudm nudm,
	SessionPars_NGNAS nas
}

function f_SessionPars(integer idx := 0,
		       template (omit) hexstring msisdn := '1234'H,
		       GTP2C_RAT_Type rat_type := GTP2C_RAT_EUTRAN,
		       charstring apn := "internet",
		       boolean selection_mode := false,
		       GTP2C_PDN_Type pdn_type := GTP2C_PDN_IPv4,
		       template (omit) PfcpParameters pfcp_pars := omit)
return SessionPars {
	var hexstring imsi := f_concat_pad(lengthof(mp_imsi), substr(mp_imsi, 0, lengthof(mp_imsi) - 6), idx);
	var charstring imsi_str := f_dec_TBCD(imsi_hex2oct(imsi));
	if (not isvalue(pfcp_pars)) {
		pfcp_pars := f_t_PfcpParams(idx := idx);
	}
	var template (value) SessionPars pars := {
		imsi := imsi,
		imsi_str := imsi_str,
		msisdn := msisdn,
		rat_type := rat_type,
		apn := apn,
		selection_mode := selection_mode,
		pdn_type := pdn_type,
		pco := omit,
		epco := omit,
		teic_local := int2oct(idx + 1, 4),
		teic_remote := omit,
		bearer := {
			ebi := 5,
			teid_local := int2oct(idx + 1, 4),
			teid_remote := omit
		},
		gy := {
			validity_time := 0,
			cca_res_code := DIAMETER_SUCCESS
		},
		pfcp_pars := pfcp_pars,
		namf := {
			pdu_sess_id := idx + 1,
			ran_gtpu_ip := mp_amf_local_ip,
			ran_gtpu_teid := int2oct(idx + 1, 4),
			cn_gtpu_ip := omit,
			cn_gtpu_teid := omit,
			ue_ip4 := omit,
			ue_ip6 := omit,
			ipv6_interface_id := omit
		},
		npcf := {
			sm_policy_id := imsi_str & "-" & int2str(idx + 1)
		},
		nsmf := {
			smContextRef := omit
		},
		nudm := {
			smf_subscription_id := int2str(idx + 1)
		},
		nas := {
			pti := '00'O,
			qos_rules := omit
		}
	}
	return valueof(pars);
}


type function void_fn() runs on SMF_Session_CT;

function f_handler_init(void_fn fn, SessionPars pars)
runs on SMF_Session_CT {
	g_pars := valueof(pars);

	/* No need to register g_pars.pfcp_pars.gtp1u_pars.{access,core}.local.teid since we don't expect any message on it */
	f_gtp1u_register_teid(g_pars.pfcp_pars.gtp1u_pars.cp.local.teid);

	f_handler_init_4G();
	f_handler_init_5G();

	fn.apply();
	f_handler_cleanup_5G();
}

/*******
 * PFCP
 *******/

private function f_End_Time_now()
return End_Time {
	return valueof(ts_PFCP_End_Time(int2oct(f_time_ntp32_now(), 4)));
}

private function f_Session_URR_Start_Time(Session_URR urr)
return Start_Time {
	return valueof(ts_PFCP_Start_Time(int2oct(f_time_to_ntp32(urr.start_time), 4)));
}

private function f_Session_URR_Volume_Measurement(Session_URR urr)
return Volume_Measurement {
	return valueof(ts_PFCP_Volume_Measurement(urr.ul_bytes + urr.dl_bytes,
						  urr.ul_bytes, urr.dl_bytes,
						  urr.ul_pkts + urr.dl_pkts,
						  urr.ul_pkts, urr.dl_pkts));
}

private function f_Session_URR_Duration_Measurement(inout Session_URR urr)
return Duration_Measurement {
	var integer now := f_time();
	var integer duration := now - urr.last_report_time;
	urr.last_report_time := now;
	return valueof(ts_PFCP_Duration_Measurement(duration));
}

private function f_Session_URR_Usage_Report_Deletion_Response(Session_URR urr)
return Usage_Report_Deletion_Response {
	var template (value) Usage_Report_Deletion_Response usage_report;
	usage_report:= ts_Usage_Report_Deletion_Response(urr.urr_id,
							 urr.ur_seqn,
							 ts_PFCP_Usage_Report_Trigger(termr := '1'B),
							 start_time := f_Session_URR_Start_Time(urr),
							 end_time := f_End_Time_now());
	return valueof(usage_report);
}

private function f_Session_URR_Usage_Report_Report_Request(inout Session_URR urr)
return Usage_Report_Report_Request {
	var template (value) Usage_Report_Report_Request usage_report;
	usage_report := ts_Usage_Report_Report_Request(urr.urr_id,
						       urr.ur_seqn,
						       ts_PFCP_Usage_Report_Trigger(quvti := '1'B),
						       start_time := f_Session_URR_Start_Time(urr),
						       end_time := f_End_Time_now(),
						       volume_measurement := f_Session_URR_Volume_Measurement(urr),
						       duration_measurement := f_Session_URR_Duration_Measurement(urr));
	return valueof(usage_report);
}

function f_pfcp_expect(template (present) PDU_PFCP exp_rx, float wait_time := 5.0) runs on SMF_Session_CT return PDU_PFCP
{
	var PDU_PFCP rx;
	timer T := wait_time;
	T.start;
	alt {
	[] PFCP.receive(exp_rx) -> value rx {
			setverdict(pass);
		}
	[] PFCP.receive(PDU_PFCP:?) {
			setverdict(fail, "Got an unexpected PFCP message, was waiting for ", exp_rx);
			mtc.stop;
		}
	[] T.timeout {
			setverdict(fail, "Timeout waiting for PFCP ", exp_rx);
			mtc.stop;
		}
	}
	T.stop;
	return rx;
}

function f_Session_tr_PFCP_Session_Est_Req() runs on SMF_Session_CT return template (present) PDU_PFCP
{
	var template (present) Create_PDR_list create_pdr := ?;
	var template (present) Create_FAR_list create_far := ?;
	var template Create_URR_list create_urr := *;

	if (g_pars.pdn_type == GTP2C_PDN_IPv6 or
	    g_pars.pdn_type == GTP2C_PDN_IPv4v6) {
		/* On IPv6, validate a PDR and FAR to forward IPv6 SLAAC UPF->SMF is set up: */
		var template octetstring flow_description := '7065726D6974206F75742035382066726F6D20666630323A3A*2F31323820746F2061737369676E6564'O; // ("permit out 58 from ff02::*/128 to assigned");
		create_pdr := {
			*,
			tr_PFCP_Create_PDR(pdr_id := 4,
					   pdi := tr_PFCP_PDI(src_iface := ACCESS,
							      local_F_TEID := tr_PFCP_F_TEID(?, ?, '1'B, '1'B, omit, omit, omit, ?),
							      network_instance := tr_PFCP_Network_Instance(g_pars.apn),
							      sdf_filter_list := { tr_PFCP_SDF_Filter(fd := '1'B,
												      flow_description := flow_description) },
							      source_interface_type := tr_PFCP_ThreeGPP_Interface_Type(11 /* N3 3GPP Access */)),
					  ohr := tr_PFCP_Outer_Header_Removal(GTP_U_UDP_IP),
					  far_id := 3)
			, *
		}
		create_far := {
			*,
			tr_PFCP_Create_FAR(far_id := 3,
					   aa := tr_PFCP_Apply_Action(forw := '1'B),
					   fp := tr_PFCP_Forwarding_Parameters(dest_iface := CP_FUNCTION,
									       ohc := tr_PFCP_Outer_Header_Creation_GTP_ipv4(?, f_inet_addr(mp_smf_hostname))))
			, *
		}
	}

	if (g_pars.gy.validity_time > 0) {
		create_urr := {
			tr_PFCP_Create_URR(urr_id := ?,
					   measurement_method := tr_PFCP_Measurement_Method(durat := '1'B),
					   reporting_triggers := tr_PFCP_Reporting_Triggers(quvti := '1'B),
					   quota_validity_time := tr_Quota_Validity_Time(g_pars.gy.validity_time),
					   measurement_information := tr_Measurement_Information(istm := '1'B))
		};
	}

	return tr_PFCP_Session_Est_Req(create_pdr := create_pdr,
				       create_far := create_far,
				       create_urr := create_urr);
}

altstep as_pfcp_sess_est_req()
runs on SMF_Session_CT {
	var template (present) PDU_PFCP exp_req := f_Session_tr_PFCP_Session_Est_Req();
	var PDU_PFCP req;
	[] PFCP.receive(exp_req) -> value req {
		f_pfcp_sess_est_resp(req);
	}
}

function f_pfcp_sess_est_resp(PDU_PFCP req) runs on SMF_Session_CT {
	var template PDU_PFCP resp;
	var PFCP_Session_Establishment_Response.created_PDR_list pdrs := {};
	var PFCP_Session_Establishment_Request serq := req.message_body.pfcp_session_establishment_request;
	var Outer_Header_Creation ohc := serq.create_FAR_list[2].grouped_ie.forwarding_parameters.grouped_ie.outer_header_creation;

	/* Store peer's F-SEID for later: */
	g_pars.pfcp_pars.remote_cp_f_seid := serq.CP_F_SEID;

	/* TODO: store CP GTP1U endpoint IPaddr+TEID FAR, it will be used later to send a Router Solicitation UPF->SMF
	 * sand expect a Router Advertisement back. */
	g_pars.pfcp_pars.gtp1u_pars.cp.remote := valueof(ts_PFCP_F_TEID_ipv4(ohc.teid, ohc.ipv4));

	var integer now := f_time();
	for (var integer i := 0; i < lengthof(serq.create_URR_list); i := i + 1) {
		g_pars.pfcp_pars.urr_list[i] := valueof(ts_Session_URR(serq.create_URR_list[i].grouped_ie.urr_id,
								       now));
	}


	/* Acting as UPF, invent a new PFCP SEID to send to the peer. Respond to the Session Establishment.
	 * The PFCP response must have the same sequence_number as the request. */
	var Gtp1uParameters gtp1_pars := g_pars.pfcp_pars.gtp1u_pars;
	/* Core N6: */
	pdrs := pdrs & { valueof(ts_PFCP_Created_PDR(pdr_id := serq.create_PDR_list[0].grouped_ie.pdr_id,
						     local_F_TEID := gtp1_pars.core.local)) };
	/* Access N3: */
	pdrs := pdrs & { valueof(ts_PFCP_Created_PDR(pdr_id := serq.create_PDR_list[1].grouped_ie.pdr_id,
						      local_F_TEID := gtp1_pars.access.local)) };
	/* CP Function: */
	pdrs := pdrs & { valueof(ts_PFCP_Created_PDR(pdr_id := serq.create_PDR_list[2].grouped_ie.pdr_id,
						     local_F_TEID := gtp1_pars.core.local)) };
	/* Set UE-to-CP Flow-Description: */
	pdrs := pdrs & { valueof(ts_PFCP_Created_PDR(pdr_id := serq.create_PDR_list[3].grouped_ie.pdr_id,
						     local_F_TEID := gtp1_pars.access.local)) };

	resp := ts_PFCP_Session_Est_Resp(seq_nr := req.sequence_number,
					 node_id := g_pars.pfcp_pars.local_node_id,
					 seid := g_pars.pfcp_pars.remote_cp_f_seid.seid,
					 f_seid := g_pars.pfcp_pars.local_f_seid,
					 created_pdr := pdrs);
	PFCP.send(resp);
}


function f_Session_tr_PFCP_Session_Mod_Req() runs on SMF_Session_CT return template (present) PDU_PFCP
{
	return tr_PFCP_Session_Mod_Req(g_pars.pfcp_pars.local_f_seid.seid);
}

altstep as_pfcp_sess_mod_req()
runs on SMF_Session_CT {
	var template (present) PDU_PFCP exp_req := f_Session_tr_PFCP_Session_Mod_Req();
	var PDU_PFCP req;
	[] PFCP.receive(exp_req) -> value req {
		f_pfcp_sess_mod_resp(req);
	}
}

function f_pfcp_sess_mod_resp(PDU_PFCP req) runs on SMF_Session_CT {
	var template (value) PDU_PFCP resp;
	resp := ts_PFCP_Session_Mod_Resp(seq_nr := req.sequence_number,
					 seid := g_pars.pfcp_pars.remote_cp_f_seid.seid,
					 cause := ts_PFCP_Cause(REQUEST_ACCEPTED));
	PFCP.send(resp);
}


altstep as_pfcp_sess_del_req(template (value) PFCP_Types.Cause resp_cause := ts_PFCP_Cause(REQUEST_ACCEPTED))
runs on SMF_Session_CT {
	var PDU_PFCP req;
	[] PFCP.receive(tr_PFCP_Session_Del_Req(g_pars.pfcp_pars.local_f_seid.seid)) -> value req {
		f_pfcp_sess_del_resp(req, resp_cause);
	}
}

private function f_pfcp_sess_del_resp(PDU_PFCP req,
				      template (value) PFCP_Types.Cause resp_cause := ts_PFCP_Cause(REQUEST_ACCEPTED))
runs on SMF_Session_CT {
	var template (present) PDU_PFCP resp;
	var template (omit) Usage_Report_Deletion_Response_list usage_reports := omit;

	for(var integer i := 0; i < lengthof(g_pars.pfcp_pars.urr_list); i := i +1) {
		usage_reports[i] := f_Session_URR_Usage_Report_Deletion_Response(g_pars.pfcp_pars.urr_list[i]);
	}
	resp := ts_PFCP_Session_Del_Resp(req.sequence_number, g_pars.pfcp_pars.remote_cp_f_seid.seid, resp_cause, usage_report := usage_reports)
	PFCP.send(resp);
}

/* Send a PFCP Session Report Request (Quota Vality Time triggered) */
function f_pfcp_sess_report_req() runs on SMF_Session_CT {
	var template (value) PDU_PFCP req;
	var template (omit) Usage_Report_Report_Request_list usage_reports := omit;
	for(var integer i := 0; i < lengthof(g_pars.pfcp_pars.urr_list); i := i +1) {
		usage_reports[i] := f_Session_URR_Usage_Report_Report_Request(g_pars.pfcp_pars.urr_list[i]);
	}

	req := ts_PFCP_Session_Report_Request(g_pars.pfcp_pars.remote_cp_f_seid.seid,
						ts_Report_Type(usar := '1'B),
						usage_report := usage_reports)
	PFCP.send(req);
	as_pfcp_sess_report_resp();
}

private altstep as_pfcp_sess_report_resp(template (present) PFCP_Types.Cause resp_cause := tr_PFCP_Cause(REQUEST_ACCEPTED))
runs on SMF_Session_CT {
	var PDU_PFCP resp;
	[] PFCP.receive(tr_PFCP_Session_Report_Resp(g_pars.pfcp_pars.local_f_seid.seid,
						    resp_cause)) -> value resp {
		setverdict(pass);
	}
}


/**********************************
 * GTP1U (UPF<->SMF), CP-FUNCTION
 *********************************/

template (value) Gtp1uPeer ts_GtpPeerU(charstring ip) := {
	connId := 1,
	remName := ip,
	remPort := GTP1U_PORT
}

private function f_gtp1u_send(octetstring payload) runs on SMF_Session_CT {
	var Gtp1uPeer peer := valueof(ts_GtpPeerU(f_inet_ntoa(g_pars.pfcp_pars.gtp1u_pars.cp.remote.ipv4_address)));
	GTP1U[0].send(ts_GTP1U_GPDU(peer, omit /*opt_part*/, g_pars.pfcp_pars.gtp1u_pars.cp.remote.teid, payload));
}

/* Wait for ICMPv6 from GTP */
private function f_gtp1u_wait_icmp6(template (present) PDU_ICMPv6 expected,
				    float t_timeout := 3.0)
runs on SMF_Session_CT {
	var Gtp1uUnitdata ud;
	timer T_default := t_timeout;
	T_default.start;
	alt {
		[] GTP1U[0].receive(tr_GTPU_GPDU(ts_GtpPeerU(f_inet_ntoa(g_pars.pfcp_pars.gtp1u_pars.cp.remote.ipv4_address)), ?)) -> value ud {
			var octetstring gpdu := ud.gtpu.gtpu_IEs.g_PDU_IEs.data;
			var IPv6_packet ip6 := f_IPv6_dec(gpdu);
			if (ip6.header.ver != 6 or ip6.header.nexthead != 58) {
				repeat;
			}
			var PDU_ICMPv6 icmp6 := f_dec_PDU_ICMPv6(ip6.payload);
			if (not match(icmp6, expected)) {
				repeat;
			}
			/* We are waiting for RA */
			if (match(icmp6, tr_ICMPv6_RA(?))) {
				for (var integer i := 0; i < lengthof(icmp6.routerAdvertisement.options); i := i + 1) {
					var OptionField opt := icmp6.routerAdvertisement.options[i];
					if (ischosen(opt.prefixInformation)) {
						log("SMF assigned IPv6 global prefix (len=", opt.prefixInformation.prefixLength, "): ", opt.prefixInformation.prefix, " -> ",
						    f_inet6_ntoa(opt.prefixInformation.prefix & '0000000000000000'O));
						/* Assume prefixLen will be multiple of 8, it's usually 64... */
						var OCT8 prefix := substr(opt.prefixInformation.prefix, 0, opt.prefixInformation.prefixLength / 8);
						/* Pick second address in the prefix and use it as global IPv6 address: */
						g_ip6_addr := f_pad_oct(prefix, 16, '00'O);
						g_ip6_addr[15] := '02'O;
						log("Using IPv6 global address: ", g_ip6_addr, " -> ", f_inet6_ntoa(g_ip6_addr));
						setverdict(pass)
						return;
					}
				}
				Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail,
						log2str("Rx ICMPv6 RA contain no Prefix Information option: ", icmp6));
			}
		}
		[] GTP1U[0].receive(tr_GTPU_GPDU(?, ?)) { repeat; }
		[] GTP1U[0].receive  {
			Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail,
						log2str("Received unexpected GTPU while waiting for ICMPv6: ", expected));
		}
		[] T_default.timeout {
			Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail,
						log2str("Timeout waiting for ICMPv6: ", expected));
		}
	}
	T_default.stop;
}

/* wait for GGSN to send us an ICMPv6 router advertisement */
private function f_gtp1u_wait_rtr_adv(template integer mtu := *) runs on SMF_Session_CT {
	var template (present) OptionField opt_prefix := tr_ICMP6_OptPrefix(?, 64);
	var template (present) Options opts;
	if (istemplatekind(mtu, "*")) {
		opts := ( { opt_prefix }, { opt_prefix, tr_ICMP6_OptMTU(?) } );
	} else {
		opts := { opt_prefix, tr_ICMP6_OptMTU(mtu) };
	}
	f_gtp1u_wait_icmp6(tr_ICMPv6_RA(opts));
}

function f_gtp1u_perform_ipv6_slaac() runs on SMF_Session_CT
{
	f_gtp1u_send(f_gen_icmpv6_router_solicitation(g_ip6_addr));
	f_gtp1u_wait_rtr_adv();
}

}
