import from SMF_Session_CT all;
import from SMF_Tests all;

/* Index in SMF_Session_CT inherited HTTP2_ConnHdlr ports HTTP2_CONN[] and HTTP2_CONN_PROC[] */
const integer HTTP2_CONN_SCP := 0;

function f_handler_init_5G()
runs on SMF_Session_CT {
	/* Create SCP HTTP2 sever, where IUT will send all SBI requests: */
	f_http2_server_emu_register();
}

/********************************************
 * SCP
/*******************************************/
const charstring SCP_uri_hostport := mp_scp_local_ip & ":" & int2str(mp_scp_local_port);
const charstring SCP_uri_prefix := "http://" & SCP_uri_hostport;

/************************************************************
 * N11 Nsmf (SBI): Requests towards IUT SMFs, 3GPP TS 29.502
 ************************************************************/

const charstring Nsmf_uri_hostport := mp_smf_hostname & ":" & int2str(mp_smf_sbi_port);
const charstring Nsmf_uri_prefix := "http://" & Nsmf_uri_hostport;
const charstring Nsmf_PDUSession_path_api_prefix := "/nsmf-pdusession/v1"
const charstring Nsmf_PDUSession_path_sm_contexts := Nsmf_PDUSession_path_api_prefix & "/sm-contexts";

/* 6.1.3.2 Resource: SM contexts collection */
template (value) charstring ts_Nsmf_PDUSession_path_sm_contexts(template (value) charstring smContextRef) :=
	Nsmf_PDUSession_path_sm_contexts & "/" & valueof(smContextRef);

/* 6.1.3.3 Resource: Individual SM context */
template (present) charstring tr_Nsmf_PDUSession_uri_sm_contexts(template charstring smContextRef := pattern "\d+") :=
	pattern Nsmf_uri_prefix & Nsmf_PDUSession_path_sm_contexts & "/" & smContextRef;

template (value) charstring ts_Nsmf_PDUSession_path_sm_context_modify(template (value) charstring smContextRef) :=
	Nsmf_PDUSession_path_sm_contexts & "/" & valueof(smContextRef) & "/modify";

template (value) charstring ts_Nsmf_PDUSession_path_sm_context_release(template (value) charstring smContextRef) :=
	Nsmf_PDUSession_path_sm_contexts & "/" & valueof(smContextRef) & "/release";

function f_n11_init() runs on SMF_Session_CT {
	f_http2_adapter_init();
}

function f_ts_PlmnId()
runs on SMF_Session_CT return TS29502_Nsmf_PDUSession.PlmnId {
	return valueof(TS29502_Nsmf_PDUSession_Templates.ts_PlmnId("001", "001"));
}

function f_ts_PlmnIdNid()
runs on SMF_Session_CT return TS29502_Nsmf_PDUSession.PlmnIdNid {
	return valueof(TS29502_Nsmf_PDUSession_Templates.ts_PlmnIdNid("001", "001"));
}

function f_ts_UserLocation()
runs on SMF_Session_CT return TS29502_Nsmf_PDUSession.UserLocation {
	var template (value) TS29502_Nsmf_PDUSession.PlmnId plmn_id := f_ts_PlmnId();
	return valueof(ts_UserLocation(nrLocation := ts_NrLocation(tai := ts_Tai(plmn_id, "000001"),
								   ncgi := ts_Ncgi(plmn_id, "000000000"))));
}

function f_ts_Guami()
runs on SMF_Session_CT return TS29502_Nsmf_PDUSession.Guami {
	var template (value) TS29502_Nsmf_PDUSession.PlmnIdNid plmn_id_nid := f_ts_PlmnIdNid();
	return valueof(ts_Guami(plmnId := plmn_id_nid,
			       amfId := "020040"));
}

function f_http2_encode_body_multipart_json_5gnas(octetstring json_encoded,
						  octetstring nas_ecnoded,
						  charstring boundary := "=-0EVVjxcWWFYNd1JXh1OQEg==") return octetstring
{
	var template (value) HTTP2_multipart_part_list parts;
	parts := {
		ts_HTTP2_multipart_part({ ts_HTTP2_Hdr_content_type("application/json") },
					json_encoded),
		ts_HTTP2_multipart_part({ ts_HTTP2_Hdr_content_id("5gnas-sm"),
					  ts_HTTP2_Hdr_content_type("application/vnd.3gpp.5gnas") },
					nas_ecnoded)
	};
	return f_HTTP2_multipart_msg_encode(parts, boundary);
}

function f_http2_encode_body_multipart_json_ngap(octetstring json_encoded,
						  octetstring ngap_ecnoded,
						  charstring boundary := "=-0EVVjxcWWFYNd1JXh1OQEg==") return octetstring
{
	var template (value) HTTP2_multipart_part_list parts;
	parts := {
		ts_HTTP2_multipart_part({ ts_HTTP2_Hdr_content_type("application/json") },
					json_encoded),
		ts_HTTP2_multipart_part({ ts_HTTP2_Hdr_content_id("N2SmInfo"),
					  ts_HTTP2_Hdr_content_type("application/vnd.3gpp.ngap") },
					ngap_ecnoded)
	};
	return f_HTTP2_multipart_msg_encode(parts, boundary);
}

/* Nsmf_PDUSession_CreateSMContext Request/response
 * 3GPP TS 23.502 Figure 4.3.2.2.1-1
 * 3GPP TS 29.502 6.1.3.2 */
function f_n11_create_session()
runs on SMF_Session_CT {
	var template (value) NG_NAS_UL_Message_Type nas_ul_msg;
	var ProcedureTransactionIdentifier pti := f_next_pti();
	var template (value) octetstring body;
	var integer http2_idx;
	var integer http2_stream_id := 3;
	var template (value) HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	var template (value) SmContextCreateData sm_contexts;
	var octetstring sm_contexts_enc;
	sm_contexts := ts_SmContextCreateData(supi := "imsi-" & g_pars.imsi_str,
					      pei := "imeisv-0790219824011594",
					      pduSessionId := g_pars.namf.pdu_sess_id,
					      dnn := "internet",
					      sNssai := TS29502_Nsmf_PDUSession_Templates.ts_Snssai(1),
					      servingNfId := "foobar",
					      guami := f_ts_Guami(),
					      servingNetwork := f_ts_PlmnIdNid(),
					      n1SmMsg := TS29502_Nsmf_PDUSession_Templates.ts_RefToBinaryData("5gnas-sm"),
					      anType := ThreeGPP_ACCESS,
					      ratType := ts_RatType(NR),
					      ueLocation := f_ts_UserLocation(),
					      smContextStatusUri := ts_Namf_Callback_uri_imsi_sm_context_status_id(g_pars.imsi_str, int2str(g_pars.namf.pdu_sess_id)));
	sm_contexts_enc := f_enc_SmContextCreateData(valueof(sm_contexts));

	var charstring boundary := "=-0EVVjxcWWFYNd1JXh1OQEg=="

	nas_ul_msg := cs_NG_PDU_SESSION_ESTABLISHMENT_REQUEST(cs_NG_PDU_SessionIdV(int2oct(g_pars.namf.pdu_sess_id, 1)), pti,
							      p_IntegrityProtMaxDataRate := cs_IntegrityProtMaxDataRateV('FF'O, 'FF'O),
							      p_PDU_SessionType := cs_PDU_SessionTypeTV(c_PDU_SessionType_IPv4),
							      p_SSC_Mode := cs_SSC_ModeTV('001'B));
	var octetstring nas_enc := enc_NG_NAS_UL_Message_Type(valueof(nas_ul_msg));

	body := f_http2_encode_body_multipart_json_5gnas(sm_contexts_enc, nas_enc, boundary);
	http2_idx := f_http2_adapter_find_free_idx();
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := Nsmf_uri_hostport,
										      path := Nsmf_PDUSession_path_sm_contexts),
					headers := {
						ts_HTTP2_Hdr_content_type_multipart(boundary),
						ts_HTTP2_Hdr_accept("application/json,application/vnd.3gpp.ngap,application/problem+json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-amf"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := body));

	f_http2_adapter_connect(mp_smf_hostname, mp_smf_sbi_port, mp_amf_local_ip, idx := http2_idx);

	/////////// START MUTUAL EXCLUSION ZONE ////////////
	/* This code block cannot be executed by more than one component at a time because
	 * the RANAP RAB Ass Request triggers the IUT to send PFCP Session Establishment
	 * Request PDU(s), which needs to be routed to the respective ConnHdlr component (us).
	 * As per 3GPP TS 29.244, section 7.2.2.4.2, these PFCP PDUs shall all have SEID=0,
	 * so that the PFCPEM component cannot route them unambiguously.   This is why we
	 * need to ensure that only one ConnHdlr is triggering PFCP session establishment
	 * at the given moment of time. */
	f_Mutex_lock(__BFILE__, __LINE__);
	/* Subscribe for PFCP Session Establishment Request PDU(s), which are
	 * expected to have SEID set to 0, as per 3GPP TS 29.244, section 7.2.2.4.2. */
	f_PFCPEM_subscribe_seid(c_SEID0);

	f_http2_adapter_send(http2_tx);

	/* Expect UDM to receive GET sm-data: */
	as_nudm_sdm_get_sm_data();
	/* Expect UDM to receive POST sdm-subscriptions: */
	as_nudm_sdm_post_sdm_subscriptions();

	/* Expect to receive "201 Created body={}" answer to our Nsmf sm-contexts request: */
	http2_exp_rx := tr_HTTP2_Msg(http2_idx,
				     http2_stream_id,
				     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(201),
							   headers := {*, tr_HTTP2_Hdr_location(tr_Nsmf_PDUSession_uri_sm_contexts), *}),
				     tr_HTTP2_Data_frame(stream_id := http2_stream_id,
							 end_stream_flag := true,
							 data := char2oct("{}")));
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_idx);
	/* Store obtained smContextRef:*/
	var charstring created_location := valueof(f_HTTP2_header_list_find_header(http2_rx.hb.headers, c_HTTP2_HDR_location));
	g_pars.nsmf.smContextRef := regexp(created_location, Nsmf_uri_prefix & Nsmf_PDUSession_path_sm_contexts & "/(?+)", 0);
	/* Close HTTP2 conn: */
	f_http2_adapter_close(idx := http2_idx);

	/* Expect PCF to receive POST sm-policies: */
	as_npcf_smpolicycontrol_post_sm_policies();

	/* Expect PFCP Session Establishment Request. */
	as_pfcp_sess_est_req();
	/* Ask PFCPEM to route PDUs with to be indicated F-SEID to us. */
	f_PFCPEM_subscribe_seid(g_pars.pfcp_pars.local_f_seid.seid);
	/* We're done establishing PFCP sessions, so at this point we no longer expect to
	 * receive Session Establishment Request PDUs with SEID=0.  Unregister and unlock
	 * the mutex, enabling other components to establish PFCP sessions after us. */
	f_PFCPEM_unsubscribe_seid(c_SEID0);
	f_Mutex_unlock(__BFILE__, __LINE__);
	/////////// END MUTUAL EXCLUSION ZONE ////////////

	as_namf_comm_post_n1n2_messages();

	f_n11_update_sm_context();
	setverdict(pass);
}


/* 3GPP TS 29.502 5.2.2.3 Update SM Context service operation */
function f_n11_update_sm_context()
runs on SMF_Session_CT {
	var template (value) SmContextUpdateData sm_ctx_update;
	var octetstring sm_ctx_update_enc;
	var template (value) octetstring body_enc;
	var charstring http2_boundary := "=-0EVVjxcWWFYNd1JXh1OQEg=="
	var integer http2_idx;
	var integer http2_stream_id := 3;
	var template (value) HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;

	sm_ctx_update := ts_SmContextUpdateData(ueLocation := f_ts_UserLocation(),
						n2SmInfo := TS29502_Nsmf_PDUSession_Templates.ts_RefToBinaryData("N2SmInfo"),
						n2SmInfoType := ts_N2SmInfoType(PDU_RES_SETUP_RSP));
	sm_ctx_update_enc := f_enc_SmContextUpdateData(valueof(sm_ctx_update));

	/* TODO: generate and encode ngap: */
	var octetstring ngap_enc := f_ngap_pdu_gen_PDUSessionResourceSetupResponseTransfer();

	body_enc := f_http2_encode_body_multipart_json_ngap(sm_ctx_update_enc, ngap_enc, http2_boundary);
	http2_idx := f_http2_adapter_find_free_idx();
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := Nsmf_uri_hostport,
										      path := ts_Nsmf_PDUSession_path_sm_context_modify(g_pars.nsmf.smContextRef)),
					headers := {
						ts_HTTP2_Hdr_content_type_multipart(http2_boundary),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-amf"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := body_enc));

	f_http2_adapter_connect(mp_smf_hostname, mp_smf_sbi_port, mp_amf_local_ip, idx := http2_idx);
	f_http2_adapter_send(http2_tx);

	/* SMF updates RAN GTPU IP addr+TEID info on UPF: */
	as_pfcp_sess_mod_req();

	/* SMF registers on UDM: */
	as_nudm_uecm_put_IndividualSmfRegistration();

	/* Successful answer with no content: */
	as_http2_adapter_receive(http2_rx, tr_HTTP2_Msg_204_No_Content(), idx := http2_idx);
	f_http2_adapter_close(idx := http2_idx);
	setverdict(pass);
}

/* 5.2.2.4 Release SM Context service operation */
function f_n11_delete_session()
runs on SMF_Session_CT {
	var template (value) SmContextReleaseData sm_ctx_rel;
	var octetstring sm_ctx_rel_enc;
	var template (value) octetstring body_enc;
	var charstring http2_boundary := "=-0EVVjxcWWFYNd1JXh1OQEg=="
	var integer http2_idx;
	var integer http2_stream_id := 3;
	var template (value) HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;

	sm_ctx_rel := ts_SmContextReleaseData(ueLocation := f_ts_UserLocation(),
						n2SmInfo := TS29502_Nsmf_PDUSession_Templates.ts_RefToBinaryData("N2SmInfo"),
						n2SmInfoType := ts_N2SmInfoType(PDU_RES_SETUP_RSP));
	sm_ctx_rel_enc := f_enc_SmContextReleaseData(valueof(sm_ctx_rel));

	/* TODO: generate and encode ngap: */
	var octetstring ngap_enc := f_ngap_pdu_gen_PDUSessionResourceSetupResponseTransfer();

	body_enc := f_http2_encode_body_multipart_json_ngap(sm_ctx_rel_enc, ngap_enc, http2_boundary);
	http2_idx := f_http2_adapter_find_free_idx();
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "POST",
										      scheme := "http",
										      authority := Nsmf_uri_hostport,
										      path := ts_Nsmf_PDUSession_path_sm_context_release(g_pars.nsmf.smContextRef)),
					headers := {
						ts_HTTP2_Hdr_content_type_multipart(http2_boundary),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-amf"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := ts_HTTP2_Data_frame(http2_stream_id,
							     end_stream_flag := true,
							     data := body_enc));

	f_http2_adapter_connect(mp_smf_hostname, mp_smf_sbi_port, mp_amf_local_ip, idx := http2_idx);
	f_http2_adapter_send(http2_tx);

	/* SMF deletes PDU Session on UPF: */
	as_pfcp_sess_del_req();

	/* SMF deletes policy in PCF: */
	as_npcf_smpolicycontrol_post_IndividualSMPOlicyTermination();

	/* SMF deregisters on UDM: */
	as_nudm_sdm_delete_IndividualSubscription();
	as_nudm_uecm_delete_IndividualSmfRegistration();

	/* Successful answer with no content: */
	as_http2_adapter_receive(http2_rx, tr_HTTP2_Msg_204_No_Content(), idx := http2_idx);
	f_http2_adapter_close(idx := http2_idx);
	setverdict(pass);
}

/**************************************
 * N11 Namf (SBI): Emulated AMF
 **************************************/

const charstring Namf_uri_prefix := SCP_uri_prefix;

const charstring Namf_Callback_path_api_prefix := "/namf-callback/v1";

template (value) charstring ts_Namf_Callback_uri_imsi_sm_context_status_id(template (value) charstring imsi, template (value) charstring id) :=
	Namf_uri_prefix & Namf_Communication_path_ue_contexts & "/imsi-" & valueof(imsi) & "/sm-context-status/" & valueof(id);


const charstring Namf_Communication_path_api_prefix := "/namf-comm/v1";
const charstring Namf_Communication_path_ue_contexts := Namf_Communication_path_api_prefix & "/ue-contexts";

template (value) charstring ts_Namf_Communication_path_ue_contexts(template (value) charstring imsi) :=
	Namf_Communication_path_ue_contexts & "/imsi-" & valueof(imsi);

template (value) charstring ts_Namf_Communication_path_ue_contexts_n1_n2_messages(template (value) charstring imsi) :=
	Namf_Communication_path_ue_contexts & "/imsi-" & valueof(imsi) & "/n1-n2-messages";

/* 3GPP TS 29.518:
 * 6.1.3.5 Resource: N1N2 Messages Collection */
function f_tr_Namf_Communication_post_n1n2_messages()
runs on SMF_Session_CT return template (present) HTTP2_Msg {
	var template (present) HTTP2_Msg http2_msg;
	var template (present) HTTP2_header_block hb;
	var template (present) HTTP2_pseudo_headers pseudo_headers;
	var template HTTP2_header_list headers := *;

	pseudo_headers := tr_HTTP2_pseudo_headers_Req(method := "POST",
						      path := ts_Namf_Communication_path_ue_contexts_n1_n2_messages(g_pars.imsi_str));
	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := ? /* multipart */));
	return http2_msg;
}

/* 5.2.2.3.1 N1N2MessageTransfer */
private altstep as_namf_comm_post_n1n2_messages()
runs on SMF_Session_CT {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_Namf_Communication_post_n1n2_messages()) -> value http2_rx {
		var N1N2MessageTransferReqData n1n2msg_req;
		var NGAP_IEs.PDUSessionResourceSetupRequestTransfer setup_req_transf;
		var template (value) N1N2MessageTransferRspData n1n2msg_rsp;
		var template (present) NG_NAS_DL_SM_Message_Type exp_rx_nas;
		var NG_NAS_DL_SM_Message_Type dl_nas;
		var template (value) HTTP2_Msg http2_tx;
		var octetstring body_enc;

		/* Split http2_rx.body.data into chunks since it is a multipart message: */
		var charstring content_type_val := valueof(f_HTTP2_header_list_find_header(http2_rx.hb.headers, c_HTTP2_HDR_content_type));
		var charstring boundary := f_HTTP2_header_content_type_multipart_val_get_boundary(content_type_val)
		var HTTP2_multipart_part_list parts := f_HTTP2_multipart_msg_parse(http2_rx.body.data, boundary);

		/* Decode 1st part: SBI json: */
		f_dec_N1N2MessageTransferReqData(parts[0].data, n1n2msg_req); // TODO: check returned integer.

		/* Decode 2nd part: NG-NAS: */
		dl_nas := dec_NG_NAS_DL_SM_Message_Type(parts[1].data);
		exp_rx_nas := cr_NG_PDU_SESSION_ESTABLISHMENT_ACCEPT();
		if (not match(dl_nas, exp_rx_nas)) {
			Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail,
						log2str("Rx unexpected DL NG-NAS: ", dl_nas, " vs exp ", exp_rx_nas));
		}
		g_pars.nas.qos_rules := dl_nas.pdu_Session_Establishment_Accept.authorizedQoSRules.listofQoSRules;

		/* Decode 3rd part: NGAP: */
		setup_req_transf := dec_NGAP_PDUSessionResourceSetupRequestTransfer(parts[2].data);
		f_ngap_pdu_handle_PDUSessionResourceSetupRequestTransfer(setup_req_transf);

		/* Tx answer: */
		n1n2msg_rsp := ts_N1N2MessageTransferRspData(cause := ts_N1N2MessageTransferCause(N1_N2_TRANSFER_INITIATED))
		body_enc := f_enc_N1N2MessageTransferRspData(valueof(n1n2msg_rsp));

		http2_tx := ts_HTTP2_Msg_200_OK(http2_rx.conn_id,
						http2_rx.stream_id,
						headers := {
							ts_HTTP2_Hdr_content_type("application/json; charset=utf-8")
						},
						body := ts_HTTP2_Data_frame(http2_rx.stream_id,
									    end_stream_flag := true,
									    data := body_enc));
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}

/************************************************
 * N10 Nudm (SBI): Emulated UDM, 3GPP TS 29.503
 ************************************************/

const charstring Nudm_uri_prefix := SCP_uri_prefix;
const charstring Nudm_UECM_path_api_prefix := "/nudm-uecm/v1"
const charstring Nudm_SDM_path_api_prefix := "/nudm-sdm/v2"

/* 6.2.3.5 Resource: IndividualSmfRegistration */
template (present) charstring
tr_Nudm_UECM_path_individual_smf_registration(template (present) charstring imsi := pattern "\d+",
					      template (present) charstring smf_reg := pattern "\d+")
:= pattern Nudm_UECM_path_api_prefix & "/imsi-" & imsi & "/registrations/smf-registrations/" & smf_reg;

template (value) charstring
ts_Nudm_UECM_path_individual_smf_registration(template (value) charstring imsi,
					      template (value) charstring smf_reg)
:= Nudm_UECM_path_api_prefix & "/imsi-" & valueof(imsi) & "/registrations/smf-registrations/" & valueof(smf_reg);

template (value) charstring
ts_Nudm_UECM_uri_individual_smf_registration(template (value) charstring imsi,
					     template (value) charstring smf_reg)
:= Nudm_uri_prefix & valueof(ts_Nudm_UECM_path_individual_smf_registration(imsi, smf_reg));

/* 6.1.3.3 Resource: SdmSubscriptions (Collection) */
template (value) charstring
ts_Nudm_SDM_path_sdm_subscriptions(template (value) charstring imsi)
:= Nudm_SDM_path_api_prefix & "/imsi-" & valueof(imsi) & "/sdm-subscriptions";

/* 6.1.3.4 Resource: Individual subscription (Document) */
template (present) charstring
tr_Nudm_SDM_path_individual_subscription(template (present) charstring imsi := pattern "\d+",
					 template (present) charstring subscr_id := pattern "\d+")
:= pattern Nudm_SDM_path_api_prefix & "/imsi-" & imsi & "/sdm-subscriptions/" & subscr_id;

template (value) charstring
ts_Nudm_SDM_path_individual_subscription(template (value) charstring imsi,
					 template (value) charstring subscr_id)
:= valueof(ts_Nudm_SDM_path_sdm_subscriptions(imsi)) & "/" & valueof(subscr_id);

template (value) charstring
ts_Nudm_SDM_uri_individual_subscription(template (value) charstring imsi,
					template (value) charstring subscr_id)
:= Nudm_uri_prefix & valueof(ts_Nudm_SDM_path_individual_subscription(imsi, subscr_id));

