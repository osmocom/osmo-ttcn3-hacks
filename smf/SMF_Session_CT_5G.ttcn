	hb := tr_HTTP2_header_block(pseudo_headers, headers);
	http2_msg := tr_HTTP2_Msg(?, ?,
				  hb := hb,
				  body := tr_HTTP2_Data_frame(data := decmatch tr_SmPolicyDeleteData1));
	return http2_msg;
}

/* 3GPP TS 29.503 4.2.5.2 SM Policy Association termination */
private altstep as_npcf_smpolicycontrol_post_IndividualSMPOlicyTermination()
runs on SMF_Session_CT {
	var HTTP2_Msg http2_rx;
	[] HTTP2_CONN[HTTP2_CONN_SCP].receive(f_tr_SMPolicyControl_post_IndividualSMPolicyTermination()) -> value http2_rx {
		var SmPolicyDeleteData1 del_data;
		var template (value) HTTP2_Msg http2_tx;

		f_dec_SmPolicyDeleteData1(http2_rx.body.data, del_data);

		http2_tx := ts_HTTP2_Msg_204_No_Content(http2_rx.conn_id,
							http2_rx.stream_id,
							headers := {
								ts_HTTP2_Hdr_content_type("application/json; charset=utf-8"),
