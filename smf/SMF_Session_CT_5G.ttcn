							},
							body := omit);
		HTTP2_CONN[HTTP2_CONN_SCP].send(http2_tx);
		setverdict(pass);
	}
}

/************
 * NGAP
**************/

/* Handle a PDUSessionResourceSetupRequestTransfer and return a Result */
private function f_ngap_pdu_handle_PDUSessionResourceSetupRequestTransfer(NGAP_IEs.PDUSessionResourceSetupRequestTransfer setup_req_transf)
runs on SMF_Session_CT {
	for (var integer i := 0; i < lengthof(setup_req_transf.protocolIEs); i := i + 1) {
		select (setup_req_transf.protocolIEs[i].id) {
		case (id_UL_NGU_UP_TNLInformation) {
			var UPTransportLayerInformation utli := setup_req_transf.protocolIEs[i].value_.uPTransportLayerInformation;
			g_pars.namf.cn_gtpu_ip := f_inet_ntoa(bit2oct(utli.gTPTunnel.transportLayerAddress));
			g_pars.namf.cn_gtpu_teid := utli.gTPTunnel.gTP_TEID;
			}
		case (id_QosFlowSetupRequestList) {
			var QosFlowSetupRequestList qos_req_li := setup_req_transf.protocolIEs[i].value_.QosFlowSetupRequestList;
			/* TODO: validate received QoS */
		}
		}
	}
}

private function f_ngap_pdu_gen_PDUSessionResourceSetupResponseTransfer()
runs on SMF_Session_CT return octetstring {
	var template (value) UPTransportLayerInformation utla;
	var template (value) QosFlowPerTNLInformation qos;
	var NGAP_IEs.PDUSessionResourceSetupResponseTransfer setup_resp_transf;
	var integer qos_id := bit2int(g_pars.nas.qos_rules[0].u.creat.flowIdentifier);

	/* Prepare Response for it: */
	utla := m_uPTransportLayerInformation_gTPTunnel(
			m_gTPTunnel(p_tla := oct2bit(f_inet_addr(g_pars.namf.ran_gtpu_ip)),
					p_gtp_teid := g_pars.namf.ran_gtpu_teid));
	qos := m_qosFlowPerTNLInformation(utla, { m_associatedQosFlowItem(qos_id) });
	setup_resp_transf := valueof(m_pDUSessionResourceSetupResponseTransfer(qos));

	return enc_NGAP_PDUSessionResourceSetupResponseTransfer(setup_resp_transf);
}

/************
* NG NAS
**************/

private function f_next_pti() runs on SMF_Session_CT return ProcedureTransactionIdentifier
{
	var integer i := oct2int(g_pars.nas.pti);
	if (i >= 254) {
		g_pars.nas.pti := '01'O;
	} else {
		g_pars.nas.pti := int2oct(i + 1, 1);
	}
	return g_pars.nas.pti;
}


}
