module ConnHdlr {

import from TCCEncoding_Functions all;

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from HTTP2_Types all;
import from HTTP2_Templates all;
import from HTTP2_Functions all;
import from HTTP2_Msg all;
import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from Prometheus_Checker all;

import from TS29511_N5g_eir_EquipmentIdentityCheck all;
import from TS29511_N5g_eir_EquipmentIdentityCheck_Templates all;

import from EIR_Tests all;

const integer HTTP2_CONN_SCP := 0;

/* These are a preset of path matches which can be applied through the entire lifecycle of the session: */
function f_http2_server_path_match()
runs on ConnHdlr return charstring {
	var charstring imsi_match := "*imei-" & g_pars.imei_str & "*";
	return imsi_match;
}

type record ConnHdlrPars {
	integer idx,
	hexstring imsi,
	charstring imsi_str,
	hexstring imei,
	charstring imei_str
}

type component ConnHdlr extends HTTP2_CT, HTTP2_ConnHdlr, Prometheus_Checker_CT {
	var ConnHdlrPars g_pars;
}

type function void_fn() runs on ConnHdlr;

function f_ConnHdlrPars(integer idx := 0) return ConnHdlrPars
{
	var hexstring imsi := f_concat_pad(lengthof(mp_imsi), substr(mp_imsi, 0, lengthof(mp_imsi) - 6), idx);
	var charstring imsi_str := f_dec_TBCD(imsi_hex2oct(imsi));
	var hexstring imei := f_concat_pad(lengthof(mp_imei), substr(mp_imei, 0, lengthof(mp_imei) - 6), idx);
	var charstring imei_str := f_dec_TBCD(imsi_hex2oct(imei));
	var template (value) ConnHdlrPars pars := {
		idx := idx,
		imsi := imsi,
		imsi_str := imsi_str,
		imei := imei,
		imei_str := imei_str
	};
	return valueof(pars);
}

function f_ConnHdlr_init(void_fn fn, ConnHdlrPars pars) runs on ConnHdlr {
	/* make parameters available via component variable */
	g_pars := pars;

	/* Setup */
	/* Register SCP HTTP2 sever, where IUT will send all SBI requests: */
	f_http2_server_emu_register(f_http2_server_path_match(), idx := HTTP2_CONN_SCP);
	f_http2_adapter_init();

	fn.apply();

	/* Cleanup */
	f_http2_server_emu_unregister(f_http2_server_path_match(), idx := HTTP2_CONN_SCP);
}

function f_http2_adapter_connect_eir(integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect(mp_eir_hostname, mp_eir_sbi_port, mp_amf_local_ip, idx := idx);
}

function f_http2_adapter_connect_send_eir(template (value) HTTP2_Msg http2_msg, integer idx := 0)
runs on ConnHdlr {
	f_http2_adapter_connect_eir(idx := idx);
	f_http2_adapter_send(http2_msg);
}

/********************************************
 * SCP
/*******************************************/
const charstring c_SCP_uri_hostport := mp_scp_local_ip & ":" & int2str(mp_scp_local_port);
const charstring c_SCP_uri_prefix := "http://" & c_SCP_uri_hostport;

/***********************************************************************
 * N17 N5g-eir_EquipmentIdentityCheck (SBI): Emulated AMF, 3GPP TS 29.511
 ***********************************************************************/
const charstring c_N5g_eir_uri_hostport := mp_eir_hostname & ":" & int2str(mp_eir_sbi_port);
const charstring c_N5g_eir_uri_prefix := "http://" & c_N5g_eir_uri_hostport;

/* 3GPP TS 29.511 6.1.3.2 Resource: equipmentStatus (GET) */
private function f_n17_prepare_get_equipment_status(EquipmentStatusParameters eq_status_param)
runs on ConnHdlr return HTTP2_Msg {
	var charstring path;
	var integer http2_idx;
	var integer http2_stream_id;
	var template (value) HTTP2_Msg http2_tx;

	path := c_N5g_eir_eic_path_equipment_status &
		f_enc_EquipmentStatusParameters(eq_status_param);

	http2_idx := f_http2_adapter_find_free_idx();
	http2_stream_id := f_http2_adapter_next_stream_id(http2_idx);
	http2_tx := ts_HTTP2_Msg(http2_idx,
				 http2_stream_id,
				 hb := {
					pseudo_headers := ts_HTTP2_pseudo_headers_Req(method := "GET",
										      scheme := "http",
										      authority := c_N5g_eir_uri_hostport,
										      path := path),
					headers := {
						ts_HTTP2_Hdr_content_type("application/json"),
						ts_HTTP2_Hdr_accept("application/json"),
						ts_HTTP2_Hdr_user_agent("ttcn3-ausf"),
						ts_HTTP2_Hdr_accept_encoding("gzip")
					}
				 },
				 body := omit);
	return valueof(http2_tx);
}

/* 3GPP TS 29.511 6.1.3.2 Resource: equipmentStatus (GET) */
function f_n17_get_equipment_status(template (value) EquipmentStatusParameters eq_status_param,
				    template (present) EquipmentStatus status := ?,
				    boolean exp_found := true)
runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	http2_tx := f_n17_prepare_get_equipment_status(valueof(eq_status_param));
	f_http2_adapter_connect_send_eir(http2_tx, idx := http2_tx.conn_id);

	/* 3GPP TS 29.511 Table 6.1.3.2.3.1-3 */
	if (exp_found) {
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := decmatch tr_EirResponseData(status)));
	} else {
	http2_exp_rx :=
		tr_HTTP2_Msg(http2_tx.conn_id,
			     http2_tx.stream_id,
			     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(404)),
			     tr_HTTP2_Data_frame(stream_id := http2_tx.stream_id,
						 end_stream_flag := true,
						 data := ? /* TODO: Parse applications/problem+json cause=ERROR_EQUIPMENT_UNKNOWN*/));
	}
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}

}
