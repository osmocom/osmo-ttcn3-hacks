module SCP_Tests {

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from TCCEncoding_Functions all;

import from HTTP2_Templates all;
import from HTTP2_Msg all;
import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from TS29510_Nnrf_NFDiscovery all;
import from TS29510_Nnrf_NFDiscovery_Templates all;

import from ConnHdlr all;

modulepar {

	charstring mp_scp_hostname := "127.0.0.200";
	integer	mp_scp_port := 7777;

	charstring mp_scp_fqdn_sender := "scp1.localdomain";
	charstring mp_scp_plmn_mcc := "002";
	charstring mp_scp_plmn_mnc := "001";

	charstring mp_nrf_local_ip := "127.0.0.10";
	integer mp_nrf_local_port := 7777;

	/* IP address at which we listen for HTTP2/SBI to emulate a NF in ttcn3 */
	charstring mp_nf_local_ip := "127.0.0.50";
	integer mp_nf_local_port := 7777;

	charstring mp_scp_local_plmn_mcc := "456";
	charstring mp_scp_local_plmn_mnc := "123";
}

type component MTC_CT extends HTTP2_CT, HTTP2_ConnHdlr {
	/* emulated SCP */
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_NRF;
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_NF;

	timer g_Tguard := 30.0;
}

private function f_init_http2_srv(charstring id) runs on MTC_CT {
	id := id & "-HTTP2SRV";

	var Http2ServerEmulationCfg http2_srv_cfg := {
		http2_bind_ip := mp_nrf_local_ip,
		http2_bind_port := mp_nrf_local_port,
		one_req_per_conn := false
	};
	vc_HTTP2_SRV_NRF := HTTP2_Server_Emulation_CT.create(id & "-NRF") alive;
	vc_HTTP2_SRV_NRF.start(HTTP2_Server_Emulation.main(http2_srv_cfg));

	http2_srv_cfg := {
			http2_bind_ip := mp_nf_local_ip,
			http2_bind_port := mp_nf_local_port,
			one_req_per_conn := false
	};
	vc_HTTP2_SRV_NF := HTTP2_Server_Emulation_CT.create(id & "-NF") alive;
	vc_HTTP2_SRV_NF.start(HTTP2_Server_Emulation.main(http2_srv_cfg));


	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_NRF], vc_HTTP2_SRV_NRF:CONN_PROC);
	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_NF], vc_HTTP2_SRV_NF:CONN_PROC);
}


private function f_init(integer imsi_suffix := 0, float t_guard := 30.0) runs on MTC_CT {
	var charstring id := testcasename();

	g_Tguard.start(t_guard);
	activate(as_Tguard());

	f_init_http2_srv(id);
}

private function f_shutdown() runs on MTC_CT {
	f_http2_server_close_conn_all(idx := HTTP2_CONN_NRF);
	f_http2_server_close_conn_all(idx := HTTP2_CONN_NF);
	setverdict(pass);
}

private function f_start_handler_create()
runs on MTC_CT return ConnHdlr
{
	var ConnHdlr vc_conn;
	var charstring id := testcasename();

	vc_conn := ConnHdlr.create(id);

	if (isbound(vc_HTTP2_SRV_NRF)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_NRF], vc_HTTP2_SRV_NRF:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_NRF], vc_HTTP2_SRV_NRF:CONN_PROC);
	}

	if (isbound(vc_HTTP2_SRV_NF)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_NF], vc_HTTP2_SRV_NF:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_NF], vc_HTTP2_SRV_NF:CONN_PROC);
	}

	return vc_conn;
}

private function f_start_handler_run(ConnHdlr vc_conn, void_fn fn, ConnHdlrPars pars) runs on MTC_CT
{
	vc_conn.start(f_ConnHdlr_init(fn, pars));
}

/* start a connection handler with given parameters */
private function f_start_handler(void_fn fn, ConnHdlrPars pars)
runs on MTC_CT return ConnHdlr {
	var ConnHdlr vc_conn;
	vc_conn := f_start_handler_create();
	f_start_handler_run(vc_conn, fn, pars);
	return vc_conn;
}

private altstep as_Tguard() runs on MTC_CT {
	[] g_Tguard.timeout {
		Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, "Tguard timeout");
	}
}

/* NF consumer sends to SCP without header 3gpp-sbi-target-apiroot.
 * SCP discovers an NF producer through NRF Discovery function and forwards to it. */
private function f_TC_startup_nrf_subscriptions() runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	as_Nnrf_NFM_put_nf_instance();
	f_Nnrf_NFM_wait_all_post_subscriptions();
	as_Nnrf_NFM_get_nf_instances();
}
testcase TC_startup_nrf_subscriptions() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_startup_nrf_subscriptions), pars);
	vc_conn.done;
	f_shutdown();
}

/* NF consumer sends to SCP without header 3gpp-sbi-target-apiroot.
 * SCP discovers an NF producer through NRF Discovery function and forwards to it. */
private function f_TC_indirect_route_discovery() runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	/* Test NF sendig data through IUT c-SEPP to our emulated SEPP and back: */
	http2_tx := f_n35_prepare_get_authentication_subscription();
	f_http2_adapter_connect_send_scp(http2_tx, idx := http2_tx.conn_id);

	var template (value) TS29510_Nnrf_NFDiscovery.NFProfile1 resp_nf_instance :=
		ts_NFProfile1(nfInstanceId := "foobar",
			      nfType := TS29510_Nnrf_NFDiscovery_Templates.ts_NFType1(UDR),
			      nfStatus := ts_NFStatus1(REGISTERED),
			      ipv4Addresses := { mp_nf_local_ip },
			      nfServices := { ts_NFService1(serviceInstanceId := "foobar",
							    serviceName := ts_ServiceName1(nudr_dr),
							    versions := {ts_NFServiceVersion1("v1", "v1")},
							    scheme := ts_UriScheme1(http),
							    nfServiceStatus := ts_NFServiceStatus1(REGISTERED),
							    ipEndPoints := {ts_IpEndPoint1(ipv4Address := mp_nf_local_ip,
											   port_ := mp_nf_local_port)}) } );
	as_Nnrf_DISC_get_nf_instances(resp_nf_instance := resp_nf_instance);

	as_nf_producer_receive_forwarded_traffic(f_tr_receive_forwarded_traffic());

	/* IUT SCP forwards the answer back to the NF consumer: */
	http2_exp_rx :=	tr_HTTP2_Msg(http2_tx.conn_id,
				     http2_tx.stream_id,
				     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
				     omit);
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}
testcase TC_indirect_route_discovery() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_indirect_route_discovery), pars);
	vc_conn.done;
	f_shutdown();
}

/* NF consumer sends to SCP with header 3gpp-sbi-target-apiroot to already known NF producer. SCP fowards to it. */
private function f_TC_indirect_route_target_apiroot() runs on ConnHdlr {
	var HTTP2_Msg http2_tx;
	var HTTP2_Msg http2_rx;
	var template (present) HTTP2_Msg http2_exp_rx;

	/* Test NF consumer sendig data through IUT SCP to our emulated NF producer and back: */
	http2_tx := f_n35_prepare_get_authentication_subscription(sbi_target_apiroot := c_NF_uri_prefix);
	f_http2_adapter_connect_send_scp(http2_tx, idx := http2_tx.conn_id);

	as_nf_producer_receive_forwarded_traffic(f_tr_receive_forwarded_traffic());

	/* IUT SCP forwards the answer back to the NF consumer: */
	http2_exp_rx :=	tr_HTTP2_Msg(http2_tx.conn_id,
				     http2_tx.stream_id,
				     tr_HTTP2_header_block(pseudo_headers := tr_HTTP2_pseudo_headers_Resp(200)),
				     omit);
	as_http2_adapter_receive(http2_rx, http2_exp_rx, idx := http2_tx.conn_id);

	f_http2_adapter_close(idx := http2_tx.conn_id);
	setverdict(pass);
}
testcase TC_indirect_route_target_apiroot() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_indirect_route_target_apiroot), pars);
	vc_conn.done;
	f_shutdown();
}

control {
	/* This one must be the first one: */
	execute( TC_startup_nrf_subscriptions() );

	execute( TC_indirect_route_discovery() );
	execute( TC_indirect_route_target_apiroot() );
}

}
