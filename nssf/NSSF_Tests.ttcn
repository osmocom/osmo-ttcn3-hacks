module NSSF_Tests {

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from TCCEncoding_Functions all;

import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from TS29531_Nnssf_NSSelection all;
import from TS29531_Nnssf_NSSelection_Templates all;

import from ConnHdlr all;

modulepar {
	charstring mp_nssf_hostname := "127.0.0.14";
	integer	mp_nssf_sbi_port := 7777;

	charstring mp_scp_local_ip := "127.0.0.200";
	integer mp_scp_local_port := 7777;

	/* IP address at which we listen for HTTP2/SBI to emulate a NSSF in ttcn3 */
	charstring mp_amf_local_ip := "127.0.0.6";

	HEX15n mp_imsi := '999700000000000'H;
}

type component MTC_CT extends HTTP2_CT, HTTP2_ConnHdlr {
	/* emulated SCP */
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_SCP;

	timer g_Tguard := 30.0;
}

private function f_init_http2_srv(charstring id) runs on MTC_CT {
	id := id & "-HTTP2SRV";

	var Http2ServerEmulationCfg http2_srv_cfg := {
		http2_bind_ip := mp_scp_local_ip,
		http2_bind_port := mp_scp_local_port,
		one_req_per_conn := false
	};

	vc_HTTP2_SRV_SCP := HTTP2_Server_Emulation_CT.create(id) alive;
	vc_HTTP2_SRV_SCP.start(HTTP2_Server_Emulation.main(http2_srv_cfg));

	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
}


private function f_init(float t_guard := 30.0) runs on MTC_CT {
	var charstring id := testcasename();

	g_Tguard.start(t_guard);
	activate(as_Tguard());

	f_init_http2_srv(id);
}

private function f_shutdown() runs on MTC_CT {
	f_http2_server_close_conn_all();
	setverdict(pass);
}

private function f_start_handler_create()
runs on MTC_CT return ConnHdlr
{
	var ConnHdlr vc_conn;
	var charstring id := testcasename();

	vc_conn := ConnHdlr.create(id);

	if (isbound(vc_HTTP2_SRV_SCP)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
	}

	return vc_conn;
}

private function f_start_handler_run(ConnHdlr vc_conn, void_fn fn, ConnHdlrPars pars) runs on MTC_CT
{
	vc_conn.start(f_ConnHdlr_init(fn, pars));
}

/* start a connection handler with given parameters */
private function f_start_handler(void_fn fn, ConnHdlrPars pars)
runs on MTC_CT return ConnHdlr {
	var ConnHdlr vc_conn;
	vc_conn := f_start_handler_create();
	f_start_handler_run(vc_conn, fn, pars);
	return vc_conn;
}

private altstep as_Tguard() runs on MTC_CT {
	[] g_Tguard.timeout {
		Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, "Tguard timeout");
	}
}

/* 3GPP TS 29.531 5.2.2.2.2 Get service operation of Nnssf_NSSelection service */
private function f_TC_slice_selection_information_registration() runs on ConnHdlr {
	var template (value) NetworkSliceInformationParams query;
	query := ts_NetworkSliceInformationParams(nFType := ts_NFType(AMF),
						  nFInstanceId := "ttcn3-amf-instance-id",
						  sliceInfoForRegistration := ts_SliceInfoForRegistration());
	f_n22_get_network_slice_info(net_slice_info_pars := query);
	setverdict(pass);
}
testcase TC_slice_selection_information_registration() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_slice_selection_information_registration), pars);
	vc_conn.done;
	f_shutdown();
}

/* 3GPP TS 29.531 5.2.2.2.3 Get service operation of Nnssf_NSSelection service
 * during the PDU session establishment */
private function f_TC_slice_selection_information_pdu_session() runs on ConnHdlr {
	var template (value) NetworkSliceInformationParams query;
	var template (value) SliceInfoForPDUSession pdu_sess;

	pdu_sess := ts_SliceInfoForPDUSession(sNssai := ts_Snssai(1),
					      roamingIndication := ts_RoamingIndication(NON_ROAMING))

	query := ts_NetworkSliceInformationParams(nFType := ts_NFType(AMF),
						  nFInstanceId := "ttcn3-smf-instance-id",
						  sliceInfoForPDUSession := pdu_sess
						  );
	f_n22_get_network_slice_info(net_slice_info_pars := query);
	setverdict(pass);
}
testcase TC_slice_selection_information_pdu_session() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_slice_selection_information_pdu_session), pars);
	vc_conn.done;
	f_shutdown();
}

control {
	execute( TC_slice_selection_information_registration() );
	execute( TC_slice_selection_information_pdu_session() );
}

}
