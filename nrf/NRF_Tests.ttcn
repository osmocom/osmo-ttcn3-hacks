module NRF_Tests {

import from General_Types all;
import from Native_Functions all;
import from IPL4asp_Types all;
import from Misc_Helpers all;

import from Osmocom_Types all;
import from GSM_Types all;

import from TCCEncoding_Functions all;

import from HTTP2_Adapter all;
import from HTTP2_Server_Emulation all;

import from JSON_Generic_Templates all;
import from TS29510_Nnrf_NFManagement_Templates all;

import from ConnHdlr all;

modulepar {
	charstring mp_nrf_hostname := "127.0.0.10";
	integer	mp_nrf_sbi_port := 7777;

	charstring mp_scp_local_ip := "127.0.0.200";
	integer mp_scp_local_port := 7777;

	/* IP address used as originator of our emulated AMF/SMF requests towards the UIT. */
	charstring mp_nf_local_ip := "127.0.0.6";
}

type component MTC_CT extends HTTP2_CT, HTTP2_ConnHdlr {
	/* emulated SCP */
	var HTTP2_Server_Emulation_CT vc_HTTP2_SRV_SCP;

	timer g_Tguard := 30.0;
}

private function f_init_http2_srv(charstring id) runs on MTC_CT {
	id := id & "-HTTP2SRV";

	var Http2ServerEmulationCfg http2_srv_cfg := {
		http2_bind_ip := mp_scp_local_ip,
		http2_bind_port := mp_scp_local_port,
		one_req_per_conn := false
	};

	vc_HTTP2_SRV_SCP := HTTP2_Server_Emulation_CT.create(id) alive;
	vc_HTTP2_SRV_SCP.start(HTTP2_Server_Emulation.main(http2_srv_cfg));

	connect(self:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
}


private function f_init(float t_guard := 30.0) runs on MTC_CT {
	var charstring id := testcasename();

	g_Tguard.start(t_guard);
	activate(as_Tguard());

	f_init_http2_srv(id);
}

private function f_shutdown() runs on MTC_CT {
	f_http2_server_close_conn_all();
	setverdict(pass);
}

private function f_start_handler_create()
runs on MTC_CT return ConnHdlr
{
	var ConnHdlr vc_conn;
	var charstring id := testcasename();

	vc_conn := ConnHdlr.create(id);

	if (isbound(vc_HTTP2_SRV_SCP)) {
		connect(vc_conn:HTTP2_CONN[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN);
		connect(vc_conn:HTTP2_CONN_PROC[HTTP2_CONN_SCP], vc_HTTP2_SRV_SCP:CONN_PROC);
	}

	return vc_conn;
}

private function f_start_handler_run(ConnHdlr vc_conn, void_fn fn, ConnHdlrPars pars) runs on MTC_CT
{
	vc_conn.start(f_ConnHdlr_init(fn, pars));
}

/* start a connection handler with given parameters */
private function f_start_handler(void_fn fn, ConnHdlrPars pars)
runs on MTC_CT return ConnHdlr {
	var ConnHdlr vc_conn;
	vc_conn := f_start_handler_create();
	f_start_handler_run(vc_conn, fn, pars);
	return vc_conn;
}

private altstep as_Tguard() runs on MTC_CT {
	[] g_Tguard.timeout {
		Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, "Tguard timeout");
	}
}

/* 3GPP TS 23.502 4.17.1 NF service Registration
 * 3GPP TS 29.510 5.2.2.2.2 NF (other than NRF) registration to NRF
 * 3GPP TS 23.502 4.17.3 NF service deregistration
 * 3GPP TS 29.510 5.2.2.4.2 NF Instance Deregistration */
private function f_TC_nf_service_registration_deregistration() runs on ConnHdlr {
	f_Nnrf_NFM_put_NFRegister();
	f_Nnrf_NFM_delete_NFDeregister();
	setverdict(pass);
}
testcase TC_nf_service_registration_deregistration() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_nf_service_registration_deregistration), pars);
	vc_conn.done;
	f_shutdown();
}

/* 3GPP TS 23.502 4.17.2 NF service update
 * 3GPP TS 29.510 5.2.2.3 NFUpdate */
private function f_TC_nf_service_registration_update() runs on ConnHdlr {
	f_Nnrf_NFM_put_NFRegister();
	f_Nnrf_NFM_patch_NFUpdate({ ts_PatchItem1(op := ts_PatchOperation1(replace_),
						  path := "/load",
						  value_ := ts_JSON_generic_val_string("20")) });
	f_Nnrf_NFM_delete_NFDeregister();
	setverdict(pass);
}
testcase TC_nf_service_registration_update() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_nf_service_registration_update), pars);
	vc_conn.done;
	f_shutdown();
}

/* Test already registered NF re-registering again.
 * 2nd answer should be answered with 200 OK instead of 201 Created.
 * 3GPP TS 23.502 4.17.1 NF service Registration
 * 3GPP TS 29.510 5.2.2.2.2 NF (other than NRF) registration to NRF */
private function f_TC_nf_service_re_registration() runs on ConnHdlr {
	f_Nnrf_NFM_put_NFRegister(exp_resp_code := 201);
	f_Nnrf_NFM_put_NFRegister(exp_resp_code := 200);
	f_Nnrf_NFM_delete_NFDeregister();
	setverdict(pass);
}
testcase TC_nf_service_re_registration() runs on MTC_CT {
	var ConnHdlr vc_conn;
	var ConnHdlrPars pars := f_ConnHdlrPars(0);
	f_init();
	vc_conn := f_start_handler(refers(f_TC_nf_service_re_registration), pars);
	vc_conn.done;
	f_shutdown();
}


/* TODO see procedures in 3GPP TS 23.502 4.17 */

control {
	execute( TC_nf_service_registration_deregistration() );
	execute( TC_nf_service_registration_update() );
	execute( TC_nf_service_re_registration() );
}

}
