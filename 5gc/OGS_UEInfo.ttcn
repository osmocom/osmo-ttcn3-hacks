/* open5gs-amfd http://AMF_IP:9090/ue-info */
module OGS_UEInfo {

import from Misc_Helpers all;

import from HTTP_Adapter all;
import from HTTPmsg_Types all;

import from JSON_Generic_Null_Def all;
import from JSON_Generic all;
import from JSON_Generic_Templates all;

const integer c_OGS_UEInfo_default_http_port := 9090;

template (present) JSON_generic_val
tr_OGS_UEInfo_ue_handover(template (present) integer attempted := ?,
			  template (present) integer completed := ?,
			  template (present) integer rejected := ?) :=
tr_JSON_generic_val_object({
	{ "attempted", tr_JSON_generic_val_integer(attempted) },
	{ "completed", tr_JSON_generic_val_integer(completed) },
	{ "rejected", tr_JSON_generic_val_integer(rejected) }
});

function f_OGS_UEInfo_metrics_get_ue_by_imsi(JSON_generic_val json, charstring imsi)
return JSON_generic_val {
	var universal charstring exp_supi := "imsi-" & imsi;
	if (not ischosen(json.JSON_array)) {
		 Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, log2str("json is not an array: ", json));
	}
	for (var integer i := 0; i < lengthof(json.JSON_array); i := i + 1) {
		if (not ischosen(json.JSON_array[i].JSON_object)) {
			continue;
		}
		var JSON_generic_val json_supi := f_JSON_Generic_val_object_get_val(json.JSON_array[i], "supi");
		var universal charstring supi := json_supi.JSON_string;
		if (not match (supi, exp_supi)) {
			continue;
		}
		return json.JSON_array[i];
	}
	Misc_Helpers.f_shutdown(__BFILE__, __LINE__, fail, log2str("IMSI ", imsi, " not found in: ", json));
	return json;
}

type component OGS_UEInfo_CT extends http_CT {
	var float g_tout_http := 5.0;
};

function f_OGS_UEInfo_init(charstring http_host, integer http_port := c_OGS_UEInfo_default_http_port)
runs on OGS_UEInfo_CT {
	var HTTP_Adapter_Params http_adapter_pars := {
		http_host := http_host,
		http_port := http_port,
		use_ssl := false
	};
	f_http_init(http_adapter_pars);
}

private function f_OGS_UEInfo_get_metrics_raw(integer page_size := 10000)
runs on OGS_UEInfo_CT return charstring
{
	var HTTPMessage http_resp;
	/* page=-1 needed to avoid paging... */
	f_http_tx_request(url := "/ue-info?page=-1", method := "GET", tout := g_tout_http);
	http_resp := f_http_rx_response(tr_HTTP_Resp(200), tout := g_tout_http);
	return http_resp.response.body;
}

function f_OGS_UEInfo_get_metrics()
runs on OGS_UEInfo_CT return JSON_generic_val {
	var JSON_generic_val pdu;
	var charstring raw := f_OGS_UEInfo_get_metrics_raw();
	var integer rc := f_dec_JSON(char2oct(raw), pdu); // TODO: check rc
	return f_JSON_Generic_val_object_get_val(pdu, "items");
}

function f_OGS_UEInfo_get_ue_handover(charstring imsi)
runs on OGS_UEInfo_CT return JSON_generic_val {
	var JSON_generic_val json;
	json := f_OGS_UEInfo_get_metrics();
	json := f_OGS_UEInfo_metrics_get_ue_by_imsi(json, imsi);
	json := f_JSON_Generic_val_object_get_val(json, "handover");
	return json;
}


}
